<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!-- Texto de las opciones -->
    <Style x:Key="SidebarTextStyle"
       TargetType="{x:Type TextBlock}">

        <Setter Property="VerticalAlignment"
            Value="Center"/>

        <Setter Property="Visibility"
            Value="Visible"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarExpanded}"
                     Value="False">
                <Setter Property="Visibility"
                    Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>

    </Style>

    <!-- Iconos de las opciones -->
    <Style x:Key="SidebarIconStyle"
       TargetType="{x:Type Path}">

        <Setter Property="Margin"
            Value="0,0,12,0"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarExpanded}"
                     Value="False">
                <Setter Property="Margin"
                    Value="0"/>
            </DataTrigger>
        </Style.Triggers>

    </Style>

    <!-- Botones con navegacion -->
    <Style x:Key="SidebarToggleButtonStyle"
       TargetType="{x:Type primitives:ToggleButton}">

        <Setter Property="Background"
            Value="Transparent"/>

        <Setter Property="Foreground"
            Value="{StaticResource SidebarTextBrush}"/>

        <Setter Property="BorderThickness"
            Value="0"/>

        <Setter Property="HorizontalContentAlignment"
            Value="Left"/>

        <Setter Property="Padding"
            Value="16,0"/>

        <Setter Property="FontSize"
            Value="16"/>

        <Setter Property="FontWeight"
            Value="Medium"/>

        <Setter Property="Cursor"
            Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">

                    <Border x:Name="ButtonBorder"
                        Background="Transparent"
                        CornerRadius="8">

                        <Grid>

                            <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"
                            RecognizesAccessKey="True"/>

                            <!-- Indicador verde -->
                            <Border x:Name="SelectionIndicator"
                                Width="4"
                                Height="25"
                                CornerRadius="2"
                                Background="{StaticResource EcoGreenBrush}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                Visibility="Collapsed"/>

                        </Grid>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="{StaticResource SidebarHoverBrush}"/>
                        </Trigger>

                        <Trigger Property="IsChecked"
                             Value="True">

                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="{StaticResource EcoBlueBrush}"/>

                            <Setter TargetName="SelectionIndicator"
                                Property="Visibility"
                                Value="Visible"/>

                            <Setter Property="Foreground"
                                Value="White"/>

                        </Trigger>

                        <DataTrigger Binding="{Binding IsSidebarExpanded}"
                                 Value="False">
                            <Setter TargetName="SelectionIndicator"
                                Property="Margin"
                                Value="0,0,3,0"/>
                        </DataTrigger>

                        <Trigger Property="IsEnabled"
                             Value="False">
                            <Setter Property="Opacity"
                                Value="0.5"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarExpanded}"
                     Value="False">

                <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

                <Setter Property="Padding"
                    Value="0"/>

            </DataTrigger>
        </Style.Triggers>

    </Style>

    <!-- Boton flotante del menu -->
    <Style x:Key="SidebarCollapseButtonStyle"
       TargetType="{x:Type Button}">

        <Setter Property="Background"
            Value="{StaticResource SidebarBrush}"/>

        <Setter Property="Foreground"
            Value="White"/>

        <Setter Property="BorderBrush"
            Value="{StaticResource SidebarBrush}"/>

        <Setter Property="BorderThickness"
            Value="1"/>

        <Setter Property="Cursor"
            Value="Hand"/>

        <Setter Property="ToolTip"
            Value="Contraer menú"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Border x:Name="TabBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="9,9,9,9">

                        <Border.Effect>
                            <DropShadowEffect
                            Color="#000000"
                            BlurRadius="7"
                            ShadowDepth="1"
                            Opacity="0.12"/>
                        </Border.Effect>

                        <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">
                            <Setter TargetName="TabBorder"
                                Property="Background"
                                Value="{StaticResource SidebarHoverBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed"
                             Value="True">
                            <Setter TargetName="TabBorder"
                                Property="Background"
                                Value="{StaticResource EcoBlueDarkBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsSidebarExpanded}"
                     Value="False">
                <Setter Property="ToolTip"
                    Value="Expandir menú"/>
            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!-- Flecha del boton flotante -->
    <Style x:Key="SidebarCollapseArrowStyle"
       TargetType="{x:Type Path}">

        <!-- Flecha izquierda: contraer -->
        <Setter Property="Data"
            Value="M 11,4 L 6,9 L 11,14"/>

        <Setter Property="Stroke"
            Value="White"/>

        <Setter Property="StrokeThickness"
            Value="2"/>

        <Setter Property="StrokeStartLineCap"
            Value="Round"/>

        <Setter Property="StrokeEndLineCap"
            Value="Round"/>

        <Setter Property="StrokeLineJoin"
            Value="Round"/>

        <Setter Property="Width"
            Value="18"/>

        <Setter Property="Height"
            Value="18"/>

        <Setter Property="Stretch"
            Value="Uniform"/>

        <Style.Triggers>

            <!-- Flecha derecha: expandir -->
            <DataTrigger Binding="{Binding IsSidebarExpanded}"
                     Value="False">
                <Setter Property="Data"
                    Value="M 6,4 L 11,9 L 6,14"/>
            </DataTrigger>

        </Style.Triggers>

    </Style>

</ResourceDictionary>