<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Selector reutilizable -->
    <Style x:Key="ComboBoxStyle"
       TargetType="ComboBox">

        <!-- Tamaño de fuente -->
        <Setter Property="FontSize"
            Value="14"/>

        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="70"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background"
            Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground"
            Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush"
            Value="{StaticResource BorderBrushLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="ComboBox">

                    <Grid>

                        <!-- Borde principal -->
                        <Border x:Name="SelectorBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"/>

                        <!-- Contenido seleccionado -->
                        <ContentPresenter x:Name="SelectedContent"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"/>

                        <!-- Boton desplegable -->
                        <ToggleButton x:Name="DropDownButton"
                                  Focusable="False"
                                  ClickMode="Press"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsChecked="{Binding IsDropDownOpen,
                                                      RelativeSource={RelativeSource TemplatedParent},
                                                      Mode=TwoWay}">

                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">

                                    <Grid Background="Transparent">

                                        <!-- Flecha -->
                                        <Path Data="M 0,0 L 4,4 L 8,0"
                                          Stroke="{StaticResource SecondaryTextBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>

                                    </Grid>

                                </ControlTemplate>
                            </ToggleButton.Template>

                        </ToggleButton>

                        <!-- Lista desplegable -->
                        <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           PopupAnimation="Fade">

                            <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushLight}"
                                BorderThickness="1"
                                CornerRadius="8"
                                MinWidth="{Binding ActualWidth,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                <ScrollViewer Margin="4"
                                          CanContentScroll="True">

                                    <ItemsPresenter/>

                                </ScrollViewer>

                            </Border>

                        </Popup>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Foco del selector -->
                        <Trigger Property="IsKeyboardFocusWithin"
                             Value="True">

                            <Setter TargetName="SelectorBorder"
                                Property="BorderBrush"
                                Value="{StaticResource EcoBlueBrush}"/>

                        </Trigger>

                        <!-- Estado deshabilitado -->
                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter TargetName="SelectorBorder"
                                Property="Opacity"
                                Value="0.55"/>

                            <Setter TargetName="SelectedContent"
                                Property="Opacity"
                                Value="0.55"/>

                            <Setter TargetName="DropDownButton"
                                Property="IsEnabled"
                                Value="False"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <!-- Campo de texto reutilizable -->
    <Style x:Key="TextBoxStyle"
       TargetType="TextBox">

        <!-- Tamaño de fuente -->
        <Setter Property="FontSize"
            Value="14"/>

        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Padding" Value="12,0"/>

        <Setter Property="Background"
            Value="{StaticResource SurfaceBrush}"/>

        <Setter Property="Foreground"
            Value="{StaticResource PrimaryTextBrush}"/>

        <Setter Property="BorderBrush"
            Value="{StaticResource BorderBrushLight}"/>

        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="VerticalContentAlignment"
            Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="TextBox">

                    <Border x:Name="TextBoxBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">

                        <ScrollViewer x:Name="PART_ContentHost"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Resaltar el borde al recibir el foco -->
                        <Trigger Property="IsKeyboardFocusWithin"
                             Value="True">

                            <Setter TargetName="TextBoxBorder"
                                Property="BorderBrush"
                                Value="{StaticResource EcoBlueBrush}"/>

                        </Trigger>

                        <!-- Estado deshabilitado -->
                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter TargetName="TextBoxBorder"
                                Property="Opacity"
                                Value="0.55"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <!-- Estilo base para botones de acciones -->
    <Style x:Key="ActionButtonBaseStyle"
       TargetType="Button">

        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">

                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Efecto al pasar el cursor -->
                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.8"/>

                        </Trigger>

                        <!-- Efecto al presionar -->
                        <Trigger Property="IsPressed"
                             Value="True">

                            <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.65"/>

                        </Trigger>

                        <!-- Estado deshabilitado -->
                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter Property="Opacity"
                                Value="0.4"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>


    <!-- "Sin cambio" o "Antes 5,000" debajo de un campo -->
    <Style x:Key="ChangeHintStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="Margin"
                Value="0,4,0,0"/>
        <!-- Lo que cambio se resalta en ambar; "Sin cambio" queda en gris -->
        <Setter Property="Foreground"
                Value="{StaticResource WarningTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="Text"
                     Value="Sin cambio">
                <Setter Property="Foreground"
                        Value="{StaticResource SecondaryTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Titulo de seccion dentro de un formulario, como "DATOS DE LA OPERACIÓN" -->
    <Style x:Key="FormSectionTitleStyle"
           TargetType="TextBlock">

        <Setter Property="FontSize"
                Value="12"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

        <Setter Property="Foreground"
                Value="{StaticResource SecondaryTextBrush}"/>

        <Setter Property="Margin"
                Value="0,24,0,12"/>

    </Style>

    <!-- Boton con apariencia de enlace: accion secundaria junto a otro boton,
         como "Capturar manualmente". Se subraya al pasar el cursor o con el foco -->
    <Style x:Key="LinkButtonStyle"
           TargetType="Button">

        <Setter Property="Foreground"
                Value="{StaticResource EcoBlueDarkBrush}"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <!-- Fondo transparente: sin el, solo el texto recibiria el clic -->
                    <TextBlock x:Name="LinkText"
                               Text="{Binding Content,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                               Background="Transparent"
                               VerticalAlignment="Center"/>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="LinkText"
                                    Property="TextDecorations"
                                    Value="Underline"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="LinkText"
                                    Property="TextDecorations"
                                    Value="Underline"/>
                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.45"/>
                            <Setter Property="Cursor"
                                    Value="Arrow"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Barra de desplazamiento delgada, sin flechas: solo el riel con el
         indicador. Se dibuja encima del contenido, en su margen derecho -->
    <Style x:Key="ThinScrollBarThumbStyle"
           TargetType="Thumb">

        <Setter Property="Background"
                Value="#C9D3D9"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3"
                            Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#A9B6BE"/>
            </Trigger>
            <Trigger Property="IsDragging"
                     Value="True">
                <Setter Property="Background"
                        Value="#8A979F"/>
            </Trigger>
        </Style.Triggers>

    </Style>

    <Style x:Key="ThinScrollBarStyle"
           TargetType="ScrollBar">

        <Setter Property="Width"
                Value="6"/>

        <Setter Property="MinWidth"
                Value="6"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track"
                           IsDirectionReversed="True"
                           Focusable="False">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThinScrollBarThumbStyle}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Lista con desplazamiento vertical y barra delgada. El contenido debe
         dejar unos 12 px libres a la derecha para que la barra no lo tape -->
    <Style x:Key="ThinScrollViewerStyle"
           TargetType="ScrollViewer">

        <Setter Property="HorizontalScrollBarVisibility"
                Value="Disabled"/>

        <Setter Property="VerticalScrollBarVisibility"
                Value="Auto"/>

        <Setter Property="Focusable"
                Value="False"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>

                        <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Margin="{TemplateBinding Padding}"/>

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource ThinScrollBarStyle}"
                                   Orientation="Vertical"
                                   HorizontalAlignment="Right"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Barras de desplazamiento de toda la app: tablas, listas, ventanas y
         listas desplegables. Sin flechas, con el mismo indicador delgado que
         ThinScrollViewerStyle. Clic en el riel avanza una pagina -->
    <Style x:Key="ScrollBarPageButtonStyle"
           TargetType="RepeatButton">

        <Setter Property="Focusable"
                Value="False"/>

        <Setter Property="IsTabStop"
                Value="False"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate"
                     TargetType="ScrollBar">

        <Border Background="{TemplateBinding Background}">

            <Track x:Name="PART_Track"
                   IsDirectionReversed="True"
                   Focusable="False">

                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                  Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>

                <Track.Thumb>
                    <Thumb Style="{StaticResource ThinScrollBarThumbStyle}"
                           Margin="2,2"
                           MinHeight="28"/>
                </Track.Thumb>

                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                  Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>

            </Track>

        </Border>

    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                     TargetType="ScrollBar">

        <Border Background="{TemplateBinding Background}">

            <Track x:Name="PART_Track"
                   Focusable="False">

                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                  Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>

                <Track.Thumb>
                    <Thumb Style="{StaticResource ThinScrollBarThumbStyle}"
                           Margin="2,2"
                           MinWidth="28"/>
                </Track.Thumb>

                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                  Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>

            </Track>

        </Border>

    </ControlTemplate>

    <!-- Sin x:Key: se aplica a todas las barras, tambien las que crean las
         plantillas de DataGrid, ComboBox y ScrollViewer -->
    <Style TargetType="ScrollBar">

        <Setter Property="Background"
                Value="Transparent"/>

        <Setter Property="Stylus.IsFlicksEnabled"
                Value="False"/>

        <Style.Triggers>

            <Trigger Property="Orientation"
                     Value="Vertical">
                <Setter Property="Width"
                        Value="10"/>
                <Setter Property="MinWidth"
                        Value="10"/>
                <Setter Property="Template"
                        Value="{StaticResource VerticalScrollBarTemplate}"/>
            </Trigger>

            <Trigger Property="Orientation"
                     Value="Horizontal">
                <Setter Property="Height"
                        Value="10"/>
                <Setter Property="MinHeight"
                        Value="10"/>
                <Setter Property="Template"
                        Value="{StaticResource HorizontalScrollBarTemplate}"/>
            </Trigger>

        </Style.Triggers>

    </Style>

    <!-- Selector segmentado: ListBox horizontal donde cada opcion es un segmento.
         El ListBox ya resuelve la seleccion unica y el teclado; el estilo solo
         cambia su apariencia. El contenido de cada opcion lo define ItemTemplate -->
    <Style x:Key="SegmentedSelectorStyle"
           TargetType="ListBox">

        <Setter Property="Background"
                Value="{StaticResource SegmentedTrackBrush}"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="Padding"
                Value="3"/>

        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled"/>

        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                Value="Disabled"/>

        <!-- Todas las opciones con el mismo ancho, en una sola fila -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">

                        <ItemsPresenter/>

                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">

                    <Setter Property="Foreground"
                            Value="{StaticResource PrimaryTextBrush}"/>

                    <Setter Property="FontSize"
                            Value="14"/>

                    <Setter Property="FontWeight"
                            Value="SemiBold"/>

                    <Setter Property="MinHeight"
                            Value="34"/>

                    <Setter Property="Padding"
                            Value="14,0"/>

                    <Setter Property="Margin"
                            Value="2,0"/>

                    <Setter Property="HorizontalContentAlignment"
                            Value="Center"/>

                    <Setter Property="VerticalContentAlignment"
                            Value="Center"/>

                    <Setter Property="Cursor"
                            Value="Hand"/>

                    <!-- WPF solo dibuja el FocusVisualStyle cuando el foco llega por
                         teclado; con un clic no aparece -->
                    <Setter Property="FocusVisualStyle">
                        <Setter.Value>
                            <Style>
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Border CornerRadius="7"
                                                    BorderThickness="2"
                                                    BorderBrush="{StaticResource EcoBlueBrush}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Setter.Value>
                    </Setter>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">

                                <Border x:Name="Segment"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="{TemplateBinding Padding}">

                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                </Border>

                                <!-- El orden importa: el ultimo trigger que aplica gana,
                                     asi la opcion seleccionada no se ve como hover -->
                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Segment"
                                                Property="Background"
                                                Value="{StaticResource SegmentedHoverBrush}"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter TargetName="Segment"
                                                Property="Background"
                                                Value="{StaticResource SurfaceBrush}"/>
                                        <Setter TargetName="Segment"
                                                Property="BorderBrush"
                                                Value="{StaticResource BorderBrushLight}"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource EcoBlueDarkBrush}"/>
                                    </Trigger>

                                    <Trigger Property="IsEnabled"
                                             Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.5"/>
                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                </Style>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>