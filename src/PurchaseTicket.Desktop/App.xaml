<Application x:Class="PurchaseTicket.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PurchaseTicket.Desktop"
             xmlns:converters="clr-namespace:PurchaseTicket.Desktop.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Themes/Colors.xaml"/>

                <ResourceDictionary Source="Themes/Icons.xaml"/>

                <ResourceDictionary Source="Themes/Controls.xaml"/>

                <ResourceDictionary Source="Themes/DataGridStyles.xaml"/>

                <ResourceDictionary Source="Themes/SidebarStyles.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <!-- Convierte true/false en Visible/Collapsed -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!-- Telefono de 10 digitos como "911 234 5678"; sin telefono, "Sin registrar" -->
            <converters:PhoneNumberDisplayConverter x:Key="PhoneNumberDisplay"/>

            <!-- Un recurso por su clave, como los iconos del menu lateral -->
            <converters:ResourceKeyConverter x:Key="ResourceByKey"/>

        </ResourceDictionary>
    </Application.Resources>

</Application>