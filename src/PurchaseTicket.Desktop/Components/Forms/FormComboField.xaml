<UserControl x:Class="PurchaseTicket.Desktop.Components.Forms.FormComboField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="clr-namespace:PurchaseTicket.Desktop.Components.Forms"
             Validation.ErrorTemplate="{x:Null}"
             x:Name="Root">

    <!-- Selector de formulario: misma etiqueta, borde y error que FormTextField -->
    <StackPanel>

        <!-- Etiqueta del campo -->
        <forms:FormFieldLabel Text="{Binding Label, ElementName=Root}"
                              IsRequired="{Binding IsRequired, ElementName=Root}"
                              Margin="0,0,0,7"/>

        <Grid>

            <!-- Selector -->
            <ComboBox x:Name="InputComboBox"
                      ItemsSource="{Binding ItemsSource, ElementName=Root}"
                      DisplayMemberPath="{Binding DisplayMemberPath, ElementName=Root}"
                      SelectedValuePath="{Binding SelectedValuePath, ElementName=Root}"
                      SelectedValue="{Binding SelectedValue,
                                              ElementName=Root,
                                              Mode=TwoWay}"
                      Height="40">

                <ComboBox.Style>
                    <Style TargetType="ComboBox"
                           BasedOn="{StaticResource ComboBoxStyle}">

                        <Style.Triggers>

                            <!-- Borde rojo cuando el campo tiene un error -->
                            <DataTrigger Binding="{Binding (Validation.HasError), ElementName=Root}"
                                         Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{StaticResource ErrorBrush}"/>
                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </ComboBox.Style>

            </ComboBox>

            <!-- Texto de ayuda mientras no hay seleccion; no intercepta el clic -->
            <TextBlock Text="{Binding Placeholder, ElementName=Root}"
                       Margin="11,0,30,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       IsHitTestVisible="False">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding SelectedItem, ElementName=InputComboBox}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

        </Grid>

        <!-- Mensaje de error del campo -->
        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=Root}"
                   FontSize="12"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,5,0,0"
                   Visibility="{Binding (Validation.HasError),
                                        ElementName=Root,
                                        Converter={StaticResource BoolToVisibility}}"/>

    </StackPanel>

</UserControl>