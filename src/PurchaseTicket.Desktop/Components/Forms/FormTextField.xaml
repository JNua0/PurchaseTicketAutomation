<UserControl x:Class="PurchaseTicket.Desktop.Components.Forms.FormTextField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="clr-namespace:PurchaseTicket.Desktop.Components.Forms"
             Validation.ErrorTemplate="{x:Null}"
             x:Name="Root">

    <!-- Campo de texto reutilizable -->
    <StackPanel>

        <!-- Etiqueta del campo y, si hay limite, el contador de caracteres -->
        <Grid Margin="0,0,0,7">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <forms:FormFieldLabel Grid.Column="0"
                                  Text="{Binding Label, ElementName=Root}"
                                  IsRequired="{Binding IsRequired, ElementName=Root}"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding CounterText, ElementName=Root}"
                       FontSize="12"
                       VerticalAlignment="Bottom"
                       Margin="12,0,0,0">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Foreground"
                                Value="{StaticResource SecondaryTextBrush}"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding CounterText, ElementName=Root}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>

                            <!-- Pasado el limite el contador avisa antes de guardar -->
                            <DataTrigger Binding="{Binding IsOverLimit, ElementName=Root}"
                                         Value="True">
                                <Setter Property="Foreground"
                                        Value="{StaticResource ErrorBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

        </Grid>

        <!-- Entrada de texto -->
        <TextBox x:Name="InputTextBox"
                 Text="{Binding Text,
                                ElementName=Root,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{Binding MaxLength, ElementName=Root}"
                 CharacterCasing="{Binding CharacterCasing, ElementName=Root}">

            <TextBox.Style>
                <Style TargetType="TextBox"
                       BasedOn="{StaticResource TextBoxStyle}">

                    <Style.Triggers>

                        <!-- Borde rojo cuando el campo tiene un error -->
                        <DataTrigger Binding="{Binding (Validation.HasError), ElementName=Root}"
                                     Value="True">

                            <Setter Property="BorderBrush"
                                    Value="{StaticResource ErrorBrush}"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </TextBox.Style>

        </TextBox>

        <!-- Mensaje de error del campo -->
        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=Root}"
                   FontSize="12"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,5,0,0">

            <TextBlock.Style>
                <Style TargetType="TextBlock">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding (Validation.HasError), ElementName=Root}"
                                     Value="True">

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </TextBlock.Style>

        </TextBlock>

    </StackPanel>

</UserControl>