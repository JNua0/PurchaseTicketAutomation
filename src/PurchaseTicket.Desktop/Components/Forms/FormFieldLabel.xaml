<UserControl x:Class="PurchaseTicket.Desktop.Components.Forms.FormFieldLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Etiqueta de campo: nombre y marca de obligatorio u opcional.
         La comparten todos los campos de formulario para verse iguales -->
    <StackPanel Orientation="Horizontal">

        <!-- Nombre del campo -->
        <TextBlock Text="{Binding Text, ElementName=Root}"
                   FontSize="13"
                   FontWeight="Medium"
                   Foreground="{StaticResource PrimaryTextBrush}"/>

        <!-- Indicador de campo obligatorio -->
        <TextBlock Text=" *"
                   FontSize="13"
                   FontWeight="Medium"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   Visibility="{Binding IsRequired,
                                        ElementName=Root,
                                        Converter={StaticResource BoolToVisibility}}"/>

        <!-- Indicador de campo opcional -->
        <TextBlock Text=" (opcional)"
                   FontSize="13"
                   Foreground="{StaticResource PrimaryTextBrush}">

            <TextBlock.Style>
                <Style TargetType="TextBlock">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsRequired, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </TextBlock.Style>

        </TextBlock>

    </StackPanel>

</UserControl>