<UserControl x:Class="PurchaseTicket.Desktop.Components.Forms.FormActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actions="clr-namespace:PurchaseTicket.Desktop.Components.Actions"
             x:Name="Root">

    <!-- Acciones reutilizables del formulario -->
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right">

        <!-- Cancelar operacion con Esc -->
        <actions:ActionButton Text="Cancelar"
                              Variant="Simple"
                              Command="{Binding CancelCommand, ElementName=Root}"
                              IsCancel="True"
                              Margin="0,0,10,0">

            <actions:ActionButton.Style>
                <Style TargetType="actions:ActionButton">

                    <Style.Triggers>

                        <!-- Deshabilitar durante el guardado -->
                        <DataTrigger Binding="{Binding IsSaving, ElementName=Root}"
                                     Value="True">

                            <Setter Property="IsEnabled"
                                    Value="False"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </actions:ActionButton.Style>

        </actions:ActionButton>

        <!-- Guardar formulario con Enter; sin icono propio usa el de guardar -->
        <actions:ActionButton Text="{Binding SaveButtonText, ElementName=Root}"
                              Icon="{Binding SaveButtonIcon,
                                             ElementName=Root,
                                             TargetNullValue={StaticResource SaveIcon}}"
                              Variant="Primary"
                              Command="{Binding SaveCommand, ElementName=Root}"
                              IsDefault="True"/>

    </StackPanel>

</UserControl>
