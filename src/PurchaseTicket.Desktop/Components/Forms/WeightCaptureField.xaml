<UserControl x:Class="PurchaseTicket.Desktop.Components.Forms.WeightCaptureField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actions="clr-namespace:PurchaseTicket.Desktop.Components.Actions"
             xmlns:forms="clr-namespace:PurchaseTicket.Desktop.Components.Forms"
             xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
             x:Name="Root">

    <!-- Captura de un peso: lectura del indicador o captura manual en un solo control.
         El estado y sus textos los decide WeightCaptureViewModel; aqui solo se muestran -->
    <StackPanel>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,14">

            <Border.Style>
                <Style TargetType="Border">

                    <Setter Property="BorderBrush"
                            Value="{StaticResource BorderBrushLight}"/>

                    <Style.Triggers>

                        <!-- Borde rojo cuando el campo tiene un error -->
                        <DataTrigger Binding="{Binding Capture.HasValidationError, ElementName=Root}"
                                     Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource ErrorBrush}"/>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </Border.Style>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Etiqueta y origen del peso -->
                <Grid Grid.Row="0"
                      Grid.ColumnSpan="2">

                    <forms:FormFieldLabel Text="{Binding Label, ElementName=Root}"
                                          IsRequired="{Binding IsRequired, ElementName=Root}"
                                          VerticalAlignment="Center"/>

                    <feedback:StatusBadge HorizontalAlignment="Right"
                                          Kind="Success"
                                          Text="Lectura del indicador"
                                          Visibility="{Binding Capture.HasReading,
                                                               ElementName=Root,
                                                               Converter={StaticResource BoolToVisibility}}"/>

                    <feedback:StatusBadge HorizontalAlignment="Right"
                                          Kind="Neutral"
                                          Text="Captura manual"
                                          Visibility="{Binding Capture.IsManual,
                                                               ElementName=Root,
                                                               Converter={StaticResource BoolToVisibility}}"/>

                </Grid>

                <!-- Peso y estado de la lectura -->
                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,8,0,0">

                    <Grid>

                        <!-- Peso leido, o una raya si aun no hay -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding Capture.ShowsWeightText,
                                                         ElementName=Root,
                                                         Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="{Binding Capture.WeightDisplay, ElementName=Root}"
                                       FontSize="36"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                            <TextBlock Text="kg"
                                       FontSize="18"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="8,0,0,8"/>

                        </StackPanel>

                        <!-- Peso escrito por el operador -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding Capture.IsManual,
                                                         ElementName=Root,
                                                         Converter={StaticResource BoolToVisibility}}">

                            <TextBox x:Name="ManualTextBox"
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding Capture.ManualText,
                                                    ElementName=Root,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Width="180"
                                     Height="52"
                                     FontSize="28"
                                     FontWeight="SemiBold"
                                     MaxLength="9"
                                     IsVisibleChanged="ManualTextBox_IsVisibleChanged"/>

                            <TextBlock Text="kg"
                                       FontSize="18"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="8,0,0,8"/>

                        </StackPanel>

                    </Grid>

                    <!-- Lectura en curso -->
                    <TextBlock Text="Esperando peso estable del indicador…"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,0"
                               Visibility="{Binding Capture.IsReading,
                                                    ElementName=Root,
                                                    Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Lectura fallida: el motivo queda dentro del campo, no como error del formulario -->
                    <TextBlock Text="{Binding Capture.ReadErrorMessage, ElementName=Root}"
                               FontSize="13"
                               Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="{Binding Capture.HasReadError,
                                                    ElementName=Root,
                                                    Converter={StaticResource BoolToVisibility}}"/>

                </StackPanel>

                <!-- Acciones a la derecha del peso: asi la tarjeta ocupa menos alto -->
                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,8,0,0">

                    <Button Content="Capturar manualmente"
                            Command="{Binding Capture.CaptureManuallyCommand, ElementName=Root}"
                            Style="{StaticResource LinkButtonStyle}"
                            Margin="0,0,16,0"
                            Visibility="{Binding Capture.ShowsCaptureManually,
                                                 ElementName=Root,
                                                 Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Sin peso: la lectura es el siguiente paso, boton relleno -->
                    <actions:ActionButton Text="{Binding Capture.ReadButtonText, ElementName=Root}"
                                          Icon="{StaticResource RefreshIcon}"
                                          Variant="Primary"
                                          Command="{Binding Capture.ReadCommand, ElementName=Root}"
                                          Visibility="{Binding Capture.IsReadPrimary,
                                                               ElementName=Root,
                                                               Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Con peso: leer de nuevo es opcional, boton de contorno -->
                    <actions:ActionButton Text="{Binding Capture.ReadButtonText, ElementName=Root}"
                                          Icon="{StaticResource RefreshIcon}"
                                          Variant="Secondary"
                                          Command="{Binding Capture.ReadCommand, ElementName=Root}"
                                          Visibility="{Binding Capture.IsReadSecondary,
                                                               ElementName=Root,
                                                               Converter={StaticResource BoolToVisibility}}"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Error del campo -->
        <TextBlock Text="{Binding Capture.ValidationError, ElementName=Root}"
                   FontSize="12"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,5,0,0"
                   Visibility="{Binding Capture.HasValidationError,
                                        ElementName=Root,
                                        Converter={StaticResource BoolToVisibility}}"/>

    </StackPanel>

</UserControl>