<UserControl x:Class="PurchaseTicket.Desktop.Components.Forms.DialogLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="clr-namespace:PurchaseTicket.Desktop.Components.Forms"
             x:Name="Root">

    <!-- Estructura fija de una ventana de formulario: encabezado, cuerpo y
         barra de acciones. Cada ventana solo llena las secciones -->
    <Grid>

        <Grid.RowDefinitions>
            <!-- Encabezado -->
            <RowDefinition Height="Auto"/>

            <!-- Cuerpo -->
            <RowDefinition Height="*"/>

            <!-- Barra de acciones -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado: titulo y descripcion a la izquierda, contenido opcional a la derecha -->
        <Grid Grid.Row="0"
              Margin="28,28,28,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <forms:FormHeader Grid.Column="0"
                              Title="{Binding Title, ElementName=Root}"
                              Description="{Binding Description, ElementName=Root}"/>

            <!-- Por ejemplo, el estado del ticket -->
            <ContentPresenter Grid.Column="1"
                              Margin="16,0,0,0"
                              VerticalAlignment="Top"
                              Content="{Binding HeaderContent, ElementName=Root}"/>

        </Grid>

        <!-- Cuerpo: secciones del formulario. Sin barra de desplazamiento: si la
             pantalla es mas baja que el formulario, se desplaza con la rueda del raton -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">

            <ContentPresenter Margin="28,22,28,22"
                              Content="{Binding BodyContent, ElementName=Root}"/>

        </ScrollViewer>

        <!-- Barra de acciones separada del cuerpo por una linea -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="0,1,0,0"
                Padding="28,18,28,24">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Opcion secundaria, como imprimir al registrar -->
                <ContentPresenter Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Content="{Binding FooterContent, ElementName=Root}"/>

                <!-- Botones de cancelar y guardar -->
                <ContentPresenter Grid.Column="1"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="{Binding Actions, ElementName=Root}"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>