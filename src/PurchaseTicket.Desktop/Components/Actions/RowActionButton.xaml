<UserControl x:Class="PurchaseTicket.Desktop.Components.Actions.RowActionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actions="clr-namespace:PurchaseTicket.Desktop.Components.Actions"
             x:Name="Root">

    <!-- Boton de icono para las acciones de una fila. Un solo componente con
         variantes en lugar de uno por accion: cambia el icono y el color -->
    <Button Command="{Binding Command, ElementName=Root}"
            CommandParameter="{Binding CommandParameter, ElementName=Root}">

        <Button.Style>
            <Style TargetType="Button"
                   BasedOn="{StaticResource ActionButtonBaseStyle}">

                <Setter Property="Background"
                        Value="{StaticResource InfoSoftBrush}"/>

                <Style.Triggers>

                    <DataTrigger Binding="{Binding Variant, ElementName=Root}"
                                 Value="{x:Static actions:RowActionVariant.Neutral}">
                        <Setter Property="Background"
                                Value="{StaticResource NeutralSoftBrush}"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Variant, ElementName=Root}"
                                 Value="{x:Static actions:RowActionVariant.Danger}">
                        <Setter Property="Background"
                                Value="{StaticResource ErrorSoftBrush}"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Variant, ElementName=Root}"
                                 Value="{x:Static actions:RowActionVariant.Success}">
                        <Setter Property="Background"
                                Value="{StaticResource SuccessSoftBrush}"/>
                    </DataTrigger>

                </Style.Triggers>

            </Style>
        </Button.Style>

        <Path Data="{Binding Icon, ElementName=Root}"
              Width="16"
              Height="16"
              Stretch="Uniform"
              StrokeThickness="1.8"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round">

            <Path.Style>
                <Style TargetType="Path">

                    <Setter Property="Stroke"
                            Value="{StaticResource EcoBlueBrush}"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding Variant, ElementName=Root}"
                                     Value="{x:Static actions:RowActionVariant.Neutral}">
                            <Setter Property="Stroke"
                                    Value="{StaticResource PrimaryTextBrush}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Variant, ElementName=Root}"
                                     Value="{x:Static actions:RowActionVariant.Danger}">
                            <Setter Property="Stroke"
                                    Value="{StaticResource ErrorBrush}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Variant, ElementName=Root}"
                                     Value="{x:Static actions:RowActionVariant.Success}">
                            <Setter Property="Stroke"
                                    Value="{StaticResource SuccessBrush}"/>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </Path.Style>

        </Path>

    </Button>

</UserControl>