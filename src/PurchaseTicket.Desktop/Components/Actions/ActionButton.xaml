<UserControl x:Class="PurchaseTicket.Desktop.Components.Actions.ActionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Boton de ventana o de vista: texto, icono opcional y una de cuatro variantes -->
    <Button Command="{Binding Command, ElementName=Root}"
            CommandParameter="{Binding CommandParameter, ElementName=Root}"
            IsDefault="{Binding IsDefault, ElementName=Root}"
            IsCancel="{Binding IsCancel, ElementName=Root}">

        <Button.Style>
            <Style TargetType="Button">

                <!-- Simple por defecto: contorno y texto gris -->
                <Setter Property="Height"
                        Value="38"/>
                <Setter Property="MinWidth"
                        Value="110"/>
                <Setter Property="Padding"
                        Value="18,0"/>
                <Setter Property="FontSize"
                        Value="14"/>
                <Setter Property="FontWeight"
                        Value="SemiBold"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="Background"
                        Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource SecondaryTextBrush}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource SecondaryTextBrush}"/>

                <!-- Tag guarda el fondo al pasar el cursor, distinto en cada variante -->
                <Setter Property="Tag"
                        Value="{StaticResource NeutralSoftBrush}"/>

                <Setter Property="Template">
                    <Setter.Value>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <!-- Efecto al pasar el cursor -->
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Trigger>

                                <!-- Efecto al presionar -->
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Opacity"
                                            Value="0.85"/>
                                </Trigger>

                                <!-- Estado deshabilitado -->
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Opacity"
                                            Value="0.45"/>
                                    <Setter Property="Cursor"
                                            Value="Arrow"/>
                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>
                </Setter>

                <Style.Triggers>

                    <!-- Primary: relleno azul, la accion principal -->
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}"
                                 Value="Primary">
                        <Setter Property="Background"
                                Value="{StaticResource EcoBlueBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource EcoBlueBrush}"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="Tag"
                                Value="{StaticResource EcoBlueDarkBrush}"/>
                    </DataTrigger>

                    <!-- Secondary: contorno azul, acciones que no cambian datos -->
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}"
                                 Value="Secondary">
                        <Setter Property="BorderBrush"
                                Value="{StaticResource EcoBlueBrush}"/>
                        <Setter Property="Foreground"
                                Value="{StaticResource EcoBlueDarkBrush}"/>
                        <Setter Property="Tag"
                                Value="{StaticResource InfoSoftBrush}"/>
                    </DataTrigger>

                    <!-- Danger: contorno rojo, acciones destructivas -->
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}"
                                 Value="Danger">
                        <Setter Property="BorderBrush"
                                Value="{StaticResource ErrorBrush}"/>
                        <Setter Property="Foreground"
                                Value="{StaticResource ErrorBrush}"/>
                        <Setter Property="Tag"
                                Value="{StaticResource ErrorSoftBrush}"/>
                    </DataTrigger>

                    <!-- Compacto: dentro de las filas de una tabla -->
                    <DataTrigger Binding="{Binding IsCompact, ElementName=Root}"
                                 Value="True">
                        <Setter Property="Height"
                                Value="34"/>
                        <Setter Property="MinWidth"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="12,0"/>
                    </DataTrigger>

                </Style.Triggers>

            </Style>
        </Button.Style>

        <StackPanel Orientation="Horizontal">

            <!-- El icono toma el color del texto; sin icono no ocupa espacio -->
            <Path Data="{Binding Icon, ElementName=Root}"
                  Width="15"
                  Height="15"
                  Margin="0,0,8,0"
                  Stretch="Uniform"
                  Stroke="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  VerticalAlignment="Center">

                <Path.Style>
                    <Style TargetType="Path">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Icon, ElementName=Root}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>

            </Path>

            <TextBlock Text="{Binding Text, ElementName=Root}"
                       VerticalAlignment="Center"/>

            <!-- Contenido extra despues del texto, como un contador o una flecha -->
            <ContentPresenter Content="{Binding TrailingContent, ElementName=Root}"
                              VerticalAlignment="Center"/>

        </StackPanel>

    </Button>

</UserControl>
