<UserControl x:Class="PurchaseTicket.Desktop.Components.Actions.StatusActionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Boton reutilizable para cambiar el estado -->
    <Button Command="{Binding Command, ElementName=Root}"
            CommandParameter="{Binding CommandParameter, ElementName=Root}">

        <Button.Style>
            <Style TargetType="Button"
                   BasedOn="{StaticResource DeactivateActionButtonStyle}">

                <Style.Triggers>

                    <!-- Mostrar apariencia de activacion -->
                    <DataTrigger Binding="{Binding IsActive, ElementName=Root}"
                                 Value="False">

                        <Setter Property="Background"
                                Value="#EDF8E7"/>

                        <Setter Property="ToolTip"
                                Value="Activar registro"/>

                    </DataTrigger>

                </Style.Triggers>

            </Style>
        </Button.Style>

        <!-- Iconos del cambio de estado -->
        <Grid Width="19"
              Height="19">

            <!-- Icono para desactivar -->
            <Path Data="{Binding DeactivateIcon,
                                 ElementName=Root,
                                 TargetNullValue={StaticResource DeactivateIcon}}"
                  Fill="Transparent"
                  Stroke="{StaticResource ErrorBrush}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Stretch="Uniform">

                <Path.Style>
                    <Style TargetType="Path">

                        <Setter Property="Visibility"
                                Value="Visible"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsActive, ElementName=Root}"
                                         Value="False">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </Path.Style>

            </Path>

            <!-- Icono para activar -->
            <Path Data="{Binding ActivateIcon,
                                 ElementName=Root,
                                 TargetNullValue={StaticResource ActivateIcon}}"
                  Fill="Transparent"
                  Stroke="{StaticResource SuccessBrush}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Stretch="Uniform">

                <Path.Style>
                    <Style TargetType="Path">

                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsActive, ElementName=Root}"
                                         Value="False">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </Path.Style>

            </Path>

        </Grid>

    </Button>

</UserControl>
