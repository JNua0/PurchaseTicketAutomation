<UserControl x:Class="PurchaseTicket.Desktop.Components.Actions.EditActionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Boton reutilizable para editar registros -->
    <Button Style="{StaticResource EditActionButtonStyle}"
            Command="{Binding Command, ElementName=Root}"
            CommandParameter="{Binding CommandParameter, ElementName=Root}"
            ToolTip="{Binding ToolTip, ElementName=Root}">

        <Path Data="{StaticResource EditIcon}"
              Stroke="{StaticResource EcoBlueBrush}"
              StrokeThickness="1.8"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              Width="17"
              Height="17"
              Stretch="Uniform"/>

    </Button>

</UserControl>
