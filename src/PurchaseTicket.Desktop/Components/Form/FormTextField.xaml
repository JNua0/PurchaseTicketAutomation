<UserControl x:Class="PurchaseTicket.Desktop.Components.Forms.FormTextField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Campo de texto reutilizable -->
    <StackPanel>

        <!-- Etiqueta del campo -->
        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,7">

            <!-- Nombre del campo -->
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{StaticResource PrimaryTextBrush}"/>

            <!-- Indicador de campo obligatorio -->
            <TextBlock Text=" *"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{StaticResource PrimaryTextBrush}">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsRequired, ElementName=Root}"
                                         Value="True">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

            <!-- Indicador de campo opcional -->
            <TextBlock Text=" (opcional)"
                       FontSize="13"
                       Foreground="{StaticResource PrimaryTextBrush}">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                                Value="Visible"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsRequired, ElementName=Root}"
                                         Value="True">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

        </StackPanel>

        <!-- Entrada de texto -->
        <TextBox x:Name="InputTextBox"
                 Style="{StaticResource TextBoxStyle}"
                 Text="{Binding Text,
                                ElementName=Root,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{Binding MaxLength, ElementName=Root}"/>

    </StackPanel>

</UserControl>
