<UserControl x:Class="PurchaseTicket.Desktop.Components.Forms.FormHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Encabezado reutilizable para formularios -->
    <StackPanel>

        <!-- Titulo del formulario -->
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   TextWrapping="Wrap"/>

        <!-- Descripcion del formulario -->
        <TextBlock Text="{Binding Description, ElementName=Root}"
                   FontSize="13"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0">

            <TextBlock.Style>
                <Style TargetType="TextBlock">

                    <Style.Triggers>

                        <!-- Ocultar descripcion vacia -->
                        <DataTrigger Binding="{Binding Description, ElementName=Root}"
                                     Value="">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Description, ElementName=Root}"
                                     Value="{x:Null}">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </TextBlock.Style>

        </TextBlock>

    </StackPanel>

</UserControl>
