<UserControl x:Class="PurchaseTicket.Desktop.Components.Navigation.SidebarNavItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             x:Name="Root">

    <!-- Boton de navegacion -->
    <primitives:ToggleButton
    x:Name="NavigationButton"
        Command="{Binding Command, ElementName=Root}"
        IsChecked="{Binding IsSelected, ElementName=Root, Mode=OneWay}"
        IsEnabled="{Binding IsEnabled, ElementName=Root}"
        Style="{StaticResource SidebarToggleButtonStyle}"
        ToolTip="{Binding Text, ElementName=Root}"
        Height="50"
        Margin="0,0,0,6"
        Click="NavigationButton_Click">

        <StackPanel Orientation="Horizontal">

            <!-- Icono del modulo -->
            <Path Data="{Binding Icon, ElementName=Root}"
                  Style="{StaticResource SidebarIconStyle}"
                  Fill="Transparent"
                  Stroke="{Binding Foreground,
                      RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"
                  StrokeThickness="1.7"
                  StrokeLineJoin="Round"
                  Width="22"
                  Height="22"
                  Stretch="Uniform"/>

            <!-- Nombre del modulo -->
            <TextBlock
                Text="{Binding Text, ElementName=Root}"
                Style="{StaticResource SidebarTextStyle}"/>

        </StackPanel>

    </primitives:ToggleButton>

</UserControl>
