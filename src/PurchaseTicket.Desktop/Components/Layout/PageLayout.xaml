<UserControl x:Class="PurchaseTicket.Desktop.Components.Layout.PageLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{StaticResource ContentBrush}">

    <!-- Contenedor principal de las vistas -->
    <Grid Margin="25,20,25,25">

        <ContentPresenter
            Content="{Binding PageContent, ElementName=Root}"/>

    </Grid>

</UserControl>
