<UserControl x:Class="PurchaseTicket.Desktop.Components.Layout.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:navigation="clr-namespace:PurchaseTicket.Desktop.Components.Navigation">

    <UserControl.Resources>

        <!-- Visible solo con el menu expandido -->
        <Style x:Key="ExpandedOnlyStyle"
               TargetType="{x:Type FrameworkElement}">

            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="False">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>

        </Style>

        <!-- Visible solo con el menu contraido -->
        <Style x:Key="CollapsedOnlyStyle"
               TargetType="{x:Type FrameworkElement}">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="False">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>

        </Style>

        <!-- Opcion del menu: el icono sale de su clave de recurso -->
        <DataTemplate x:Key="NavigationItemTemplate">

            <navigation:SidebarNavItem
                Text="{Binding Label}"
                Icon="{Binding IconKey, Converter={StaticResource ResourceByKey}}"
                Command="{Binding DataContext.NavigateCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                IsSelected="{Binding IsSelected, Mode=OneWay}"/>

        </DataTemplate>

    </UserControl.Resources>

    <!-- Menu lateral con animacion de ancho -->
    <Border Background="{StaticResource SidebarBrush}"
            ClipToBounds="True">

        <Border.Style>
            <Style TargetType="{x:Type Border}">

                <Setter Property="Width"
                        Value="248"/>

                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSidebarExpanded}"
                                 Value="False">

                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="Width"
                                        To="72"
                                        Duration="0:0:0.2"
                                        AccelerationRatio="0.2"
                                        DecelerationRatio="0.8"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>

                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="Width"
                                        To="248"
                                        Duration="0:0:0.2"
                                        AccelerationRatio="0.2"
                                        DecelerationRatio="0.8"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>

                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel LastChildFill="True">

            <!-- Encabezado -->
            <Grid DockPanel.Dock="Top"
                  Margin="12,18,12,18">

                <!-- Encabezado expandido: isotipo, nombre y boton contraer -->
                <Grid Style="{StaticResource ExpandedOnlyStyle}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="38"
                            Height="38"
                            Padding="4"
                            CornerRadius="9"
                            Background="{StaticResource SurfaceBrush}">

                        <Image Source="pack://application:,,,/PurchaseTicket.Desktop;component/Assets/Images/ecopapel_isotipo.png"
                               Stretch="Uniform"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="10,0,8,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="EcoPapel"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="Tickets de compra"
                                   Foreground="{StaticResource SidebarSecondaryTextBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Contraer menú"
                            VerticalAlignment="Center">

                        <Path Data="{StaticResource PanelCloseIcon}"
                              Style="{StaticResource SidebarIconButtonPathStyle}"/>

                    </Button>

                </Grid>

                <!-- Encabezado contraido: isotipo y boton expandir debajo -->
                <StackPanel Style="{StaticResource CollapsedOnlyStyle}"
                            HorizontalAlignment="Center">

                    <Border Width="38"
                            Height="38"
                            Padding="4"
                            CornerRadius="9"
                            Background="{StaticResource SurfaceBrush}"
                            ToolTip="EcoPapel">

                        <Image Source="pack://application:,,,/PurchaseTicket.Desktop;component/Assets/Images/ecopapel_isotipo.png"
                               Stretch="Uniform"/>

                    </Border>

                    <Button Style="{StaticResource SidebarIconButtonStyle}"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Expandir menú"
                            Margin="0,10,0,0">

                        <Path Data="{StaticResource PanelOpenIcon}"
                              Style="{StaticResource SidebarIconButtonPathStyle}"/>

                    </Button>

                </StackPanel>

            </Grid>

            <!-- Configuracion anclada al fondo -->
            <StackPanel DockPanel.Dock="Bottom"
                        Margin="12,0,12,16">

                <Border Style="{StaticResource SidebarSeparatorStyle}"
                        Margin="4,0,4,12"/>

                <ContentPresenter Content="{Binding SettingsItem}"
                                  ContentTemplate="{StaticResource NavigationItemTemplate}"/>

            </StackPanel>

            <!-- Secciones de navegacion; desplazables si la ventana es baja -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Focusable="False">

                <ItemsControl ItemsSource="{Binding Sections}"
                              Margin="12,0,12,0"
                              Focusable="False">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <StackPanel Margin="0,0,0,14">

                                <!-- Titulo con el menu expandido -->
                                <TextBlock Text="{Binding Title}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource SidebarSectionTitleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded,
                                                                               RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="False">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Linea con el menu contraido; separa las secciones -->
                                <Border Margin="4,0,4,10">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}"
                                               BasedOn="{StaticResource SidebarSeparatorStyle}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded,
                                                                               RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="False">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Items}"
                                              ItemTemplate="{StaticResource NavigationItemTemplate}"
                                              Focusable="False"/>

                            </StackPanel>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </DockPanel>

    </Border>

</UserControl>
