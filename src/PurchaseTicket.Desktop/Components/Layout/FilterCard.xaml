<UserControl x:Class="PurchaseTicket.Desktop.Components.Layout.FilterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Contenedor de filtros -->
    <Border Background="{StaticResource FilterSurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">

        <ContentPresenter Content="{Binding FilterContent, ElementName=Root}"/>

    </Border>

</UserControl>
