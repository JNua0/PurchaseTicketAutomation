<UserControl x:Class="PurchaseTicket.Desktop.Components.Layout.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Encabezado reutilizable -->
    <Grid Margin="0,0,0,20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Titulo y descripcion -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

            <!-- Titulo de la pagina -->
            <TextBlock Text="{Binding Title, ElementName=Root}"
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                TextWrapping="Wrap"
                TextTrimming="CharacterEllipsis"/>

            <!-- Descripcion de la pagina -->
            <TextBlock Text="{Binding Description, ElementName=Root}"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Style.Triggers>

                            <!-- Ocultar descripcion cuando no exista -->
                            <DataTrigger Binding="{Binding Description, ElementName=Root}"
                                         Value="">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

        </StackPanel>

        <!-- Acciones de la pagina -->
        <ContentPresenter Grid.Column="1"
                          Content="{Binding Actions, ElementName=Root}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="20,0,0,0">

            <ContentPresenter.Style>
                <Style TargetType="ContentPresenter">

                    <Style.Triggers>

                        <!-- Ocultar contenedor cuando no existan acciones -->
                        <DataTrigger Binding="{Binding Actions, ElementName=Root}"
                                     Value="{x:Null}">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Setter Property="Margin"
                                    Value="0"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </ContentPresenter.Style>

        </ContentPresenter>

    </Grid>

</UserControl>
