<UserControl x:Class="PurchaseTicket.Desktop.Components.Feedback.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
             x:Name="Root">

    <!-- Etiqueta de estado con punto y fondo de color -->
    <Border CornerRadius="12"
            Padding="10,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

        <Border.Style>
            <Style TargetType="Border">

                <Setter Property="Background"
                        Value="{StaticResource NeutralSoftBrush}"/>

                <Style.Triggers>

                    <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                 Value="{x:Static feedback:StatusKind.Success}">
                        <Setter Property="Background"
                                Value="{StaticResource SuccessSoftBrush}"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                 Value="{x:Static feedback:StatusKind.Warning}">
                        <Setter Property="Background"
                                Value="{StaticResource WarningSoftBrush}"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                 Value="{x:Static feedback:StatusKind.Error}">
                        <Setter Property="Background"
                                Value="{StaticResource ErrorSoftBrush}"/>
                    </DataTrigger>

                </Style.Triggers>

            </Style>
        </Border.Style>

        <StackPanel Orientation="Horizontal">

            <!-- El punto toma el mismo color que el texto -->
            <Ellipse Width="8"
                     Height="8"
                     Margin="0,0,6,0"
                     VerticalAlignment="Center"
                     Fill="{Binding Foreground, ElementName=BadgeText}"/>

            <TextBlock x:Name="BadgeText"
                       Text="{Binding Text, ElementName=Root}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Foreground"
                                Value="{StaticResource SecondaryTextBrush}"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                         Value="{x:Static feedback:StatusKind.Success}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource SuccessBrush}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                         Value="{x:Static feedback:StatusKind.Warning}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                         Value="{x:Static feedback:StatusKind.Error}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource ErrorBrush}"/>
                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

        </StackPanel>

    </Border>

</UserControl>