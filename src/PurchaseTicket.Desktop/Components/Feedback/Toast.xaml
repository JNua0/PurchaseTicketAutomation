<UserControl x:Class="PurchaseTicket.Desktop.Components.Feedback.Toast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
             x:Name="Root">

    <!-- Aviso con icono, mensaje y boton para cerrarlo -->
    <Border CornerRadius="10"
            Padding="16,12,10,12"
            BorderThickness="1"
            MinWidth="300"
            MaxWidth="520">

        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="2"
                              Opacity="0.15"/>
        </Border.Effect>

        <Border.Style>
            <Style TargetType="Border">

                <Setter Property="Background"
                        Value="{StaticResource SuccessSoftBrush}"/>

                <Setter Property="BorderBrush"
                        Value="{StaticResource SuccessBrush}"/>

                <Style.Triggers>

                    <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                 Value="{x:Static feedback:StatusKind.Info}">
                        <Setter Property="Background"
                                Value="{StaticResource InfoSoftBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource InfoBrush}"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                 Value="{x:Static feedback:StatusKind.Warning}">
                        <Setter Property="Background"
                                Value="{StaticResource WarningSoftBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource WarningBrush}"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                 Value="{x:Static feedback:StatusKind.Error}">
                        <Setter Property="Background"
                                Value="{StaticResource ErrorSoftBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource ErrorBrush}"/>
                    </DataTrigger>

                </Style.Triggers>

            </Style>
        </Border.Style>

        <!-- Grid y no StackPanel horizontal: dentro de un StackPanel el texto
             tiene ancho infinito, nunca salta de linea y se corta -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- El icono y su color cambian segun el tipo de aviso -->
            <Path Grid.Column="0"
                  Width="20"
                  Height="20"
                  Margin="0,0,10,0"
                  VerticalAlignment="Top"
                  Stretch="Uniform"
                  Fill="Transparent"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round">

                <Path.Style>
                    <Style TargetType="Path">

                        <Setter Property="Data"
                                Value="{StaticResource ActivateIcon}"/>

                        <Setter Property="Stroke"
                                Value="{StaticResource SuccessBrush}"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                         Value="{x:Static feedback:StatusKind.Info}">
                                <Setter Property="Data"
                                        Value="{StaticResource InfoIcon}"/>
                                <Setter Property="Stroke"
                                        Value="{StaticResource InfoBrush}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                         Value="{x:Static feedback:StatusKind.Warning}">
                                <Setter Property="Data"
                                        Value="{StaticResource WarningIcon}"/>
                                <Setter Property="Stroke"
                                        Value="{StaticResource WarningTextBrush}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Kind, ElementName=Root}"
                                         Value="{x:Static feedback:StatusKind.Error}">
                                <Setter Property="Data"
                                        Value="{StaticResource DeactivateIcon}"/>
                                <Setter Property="Stroke"
                                        Value="{StaticResource ErrorBrush}"/>
                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </Path.Style>

            </Path>

            <TextBlock Grid.Column="1"
                       Text="{Binding Message, ElementName=Root}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <!-- Cerrar el aviso -->
            <Button Grid.Column="2"
                    Command="{Binding CloseCommand, ElementName=Root}"
                    ToolTip="Cerrar aviso"
                    Width="26"
                    Height="26"
                    Margin="10,-3,0,0"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    Focusable="False">

                <Button.Template>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="CloseBackground"
                                Background="Transparent"
                                CornerRadius="6">

                            <Path Data="{StaticResource CloseIcon}"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource SecondaryTextBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="CloseBackground"
                                        Property="Background"
                                        Value="#14000000"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Button.Template>

            </Button>

        </Grid>

    </Border>

</UserControl>