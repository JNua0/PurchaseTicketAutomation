<UserControl x:Class="PurchaseTicket.Desktop.Components.Feedback.QueryStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <UserControl.Style>
        <Style TargetType="UserControl">

            <!-- Ocultar cuando no existan mensajes -->
            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Style.Triggers>

                <!-- Mostrar durante la carga -->
                <DataTrigger Binding="{Binding IsLoading, ElementName=Root}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

                <!-- Mostrar cuando exista un error -->
                <DataTrigger Binding="{Binding HasError, ElementName=Root}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>
    </UserControl.Style>

    <!-- Contenedor de mensajes -->
    <Grid>

        <!-- Estado de carga -->
        <Border Background="#F0F7FF"
                CornerRadius="8"
                Padding="12">

            <Border.Style>
                <Style TargetType="Border">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsLoading, ElementName=Root}"
                                     Value="True">

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </Border.Style>

            <!-- Contenido del estado de carga -->
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Indicador de carga -->
                <TextBlock Grid.Column="0"
                           Text="◌"
                           FontSize="20"
                           Foreground="{StaticResource EcoBlueBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <!-- Mensaje de carga -->
                <TextBlock Grid.Column="1"
                           Text="{Binding LoadingMessage, ElementName=Root}"
                           FontSize="14"
                           Foreground="{StaticResource EcoBlueDarkBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

        <!-- Estado de error -->
        <Border Background="#FEF2F2"
                CornerRadius="8"
                Padding="12">

            <Border.Style>
                <Style TargetType="Border">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                    <Style.Triggers>

                        <MultiDataTrigger>

                            <MultiDataTrigger.Conditions>

                                <Condition Binding="{Binding HasError, ElementName=Root}"
                                           Value="True"/>

                                <Condition Binding="{Binding IsLoading, ElementName=Root}"
                                           Value="False"/>

                            </MultiDataTrigger.Conditions>

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                        </MultiDataTrigger>

                    </Style.Triggers>

                </Style>
            </Border.Style>

            <!-- Contenido del estado de error -->
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Indicador de error -->
                <TextBlock Grid.Column="0"
                           Text="!"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{StaticResource ErrorBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <!-- Mensaje de error -->
                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorMessage, ElementName=Root}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           Foreground="{StaticResource ErrorBrush}"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
