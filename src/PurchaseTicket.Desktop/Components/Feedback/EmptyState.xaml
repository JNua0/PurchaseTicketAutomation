<UserControl x:Class="PurchaseTicket.Desktop.Components.Feedback.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Mensaje centrado para tablas sin registros -->
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <Path Data="{StaticResource EmptyIcon}"
              Width="44"
              Height="44"
              Stretch="Uniform"
              Fill="Transparent"
              Stroke="{StaticResource SecondaryTextBrush}"
              StrokeThickness="1.5"
              StrokeLineJoin="Round"
              Margin="0,0,0,12"
              HorizontalAlignment="Center"/>

        <TextBlock Text="{Binding Message, ElementName=Root}"
                   FontSize="14"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"/>

    </StackPanel>

</UserControl>