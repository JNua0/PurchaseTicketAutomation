<UserControl x:Class="PurchaseTicket.Desktop.Components.Filters.StatusFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Name="Root">

    <!-- Filtro de estado reutilizable: Todos, Activos o Inactivos en un
         selector segmentado. Label no se muestra; lo usan los lectores de pantalla -->
    <ListBox SelectedValue="{Binding SelectedStatus,
                                     ElementName=Root,
                                     Mode=TwoWay}"
             SelectedValuePath="Tag"
             AutomationProperties.Name="{Binding Label, ElementName=Root}">

        <ListBox.Style>
            <Style TargetType="ListBox"
                   BasedOn="{StaticResource SegmentedSelectorStyle}">

                <Style.Triggers>

                    <!-- Deshabilitar durante la carga -->
                    <DataTrigger Binding="{Binding IsLoading, ElementName=Root}"
                                 Value="True">

                        <Setter Property="IsEnabled"
                                Value="False"/>

                    </DataTrigger>

                </Style.Triggers>

            </Style>
        </ListBox.Style>

        <!-- Todos los registros -->
        <ListBoxItem Content="Todos"
                     Tag="{x:Null}"/>

        <!-- Registros activos -->
        <ListBoxItem Content="Activos">
            <ListBoxItem.Tag>
                <sys:Boolean>True</sys:Boolean>
            </ListBoxItem.Tag>
        </ListBoxItem>

        <!-- Registros inactivos -->
        <ListBoxItem Content="Inactivos">
            <ListBoxItem.Tag>
                <sys:Boolean>False</sys:Boolean>
            </ListBoxItem.Tag>
        </ListBoxItem>

    </ListBox>

</UserControl>
