<UserControl x:Class="PurchaseTicket.Desktop.Components.Filters.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Campo de busqueda reutilizable -->
    <StackPanel>

        <!-- Etiqueta del campo -->
        <TextBlock Text="{Binding Label, ElementName=Root}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   Margin="0,0,0,7"/>

        <!-- Entrada de texto -->
        <TextBox Text="{Binding SearchText,
                                ElementName=Root,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}">

            <TextBox.Style>
                <Style TargetType="TextBox"
                       BasedOn="{StaticResource TextBoxStyle}">

                    <Style.Triggers>

                        <!-- Deshabilitar durante la carga -->
                        <DataTrigger Binding="{Binding IsLoading, ElementName=Root}"
                                     Value="True">

                            <Setter Property="IsEnabled"
                                    Value="False"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </TextBox.Style>

        </TextBox>

    </StackPanel>

</UserControl>
