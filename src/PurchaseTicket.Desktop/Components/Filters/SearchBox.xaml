<UserControl x:Class="PurchaseTicket.Desktop.Components.Filters.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Campo de busqueda reutilizable: Enter busca y Esc limpia.
         Sin etiqueta arriba: Label se muestra dentro del campo mientras esta vacio -->
    <Grid>

        <!-- Entrada de texto; deja espacio a la lupa y a la ayuda de teclado -->
        <TextBox x:Name="SearchTextBox"
                 Text="{Binding SearchText,
                                ElementName=Root,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{Binding Label, ElementName=Root}"
                 Padding="36,0,232,0"
                 KeyDown="SearchTextBox_KeyDown">

            <TextBox.Style>
                <Style TargetType="TextBox"
                       BasedOn="{StaticResource TextBoxStyle}">

                    <Style.Triggers>

                        <!-- Solo lectura durante la carga para no perder el foco -->
                        <DataTrigger Binding="{Binding IsLoading, ElementName=Root}"
                                     Value="True">

                            <Setter Property="IsReadOnly"
                                    Value="True"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </TextBox.Style>

        </TextBox>

        <!-- Lupa -->
        <Path Data="{StaticResource SearchIcon}"
              Width="15"
              Height="15"
              Margin="13,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Stretch="Uniform"
              Stroke="{StaticResource SecondaryTextBrush}"
              StrokeThickness="2"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              IsHitTestVisible="False"/>

        <!-- Texto guia mientras no se escribe nada -->
        <TextBlock Text="{Binding Label, ElementName=Root}"
                   Margin="38,0,232,0"
                   VerticalAlignment="Center"
                   FontSize="14"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   IsHitTestVisible="False">

            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}"
                                     Value="">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>

        </TextBlock>

        <!-- Ayuda de teclado dentro del campo, a la derecha -->
        <TextBlock Text="Enter para buscar · Esc para limpiar"
                   Margin="0,0,12,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   IsHitTestVisible="False"/>

    </Grid>

</UserControl>
