<Window x:Class="PurchaseTicket.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:views="clr-namespace:PurchaseTicket.Desktop.Views.Suppliers"
        xmlns:homeVm="clr-namespace:PurchaseTicket.Desktop.ViewModels.Home"
        xmlns:homeViews="clr-namespace:PurchaseTicket.Desktop.Views.Home"
        xmlns:vm="clr-namespace:PurchaseTicket.Desktop.ViewModels.Suppliers"
        Title="EcoPapel Recycling | Tickets de Compra"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Plantillas de vistas -->
        <DataTemplate DataType="{x:Type homeVm:HomeViewModel}">
            <homeViews:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <views:SuppliersView/>
        </DataTemplate>

        <!-- Estilo para las secciones con navegación -->
        <Style x:Key="SidebarToggleButtonStyle"
               TargetType="{x:Type primitives:ToggleButton}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SidebarTextBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="Medium"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">

                        <Border x:Name="ButtonBorder"
                                Background="Transparent"
                                CornerRadius="8">

                            <Grid>

                                <!-- Contenido del botón -->
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}"
                                    RecognizesAccessKey="True"/>

                                <!-- Indicador verde de selección -->
                                <Border x:Name="SelectionIndicator"
                                        Width="4"
                                        Height="25"
                                        CornerRadius="2"
                                        Background="{StaticResource EcoGreenBrush}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        Visibility="Collapsed"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Cursor sobre el botón -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource SidebarHoverBrush}"/>

                            </Trigger>

                            <!-- Sección seleccionada -->
                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource EcoBlueBrush}"/>

                                <Setter TargetName="SelectionIndicator"
                                        Property="Visibility"
                                        Value="Visible"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <!-- Deshabilitado -->
                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Estilo para secciones aún no implementadas -->
        <Style x:Key="SidebarButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SidebarTextBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="Medium"/>

            <Setter Property="Cursor"
                    Value="Arrow"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="Transparent"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <!-- Estructura principal -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">

            <DockPanel LastChildFill="True">

                <!-- Encabezado EcoPapel -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="20,25,20,25">

                    <!-- Logo -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,0,0,16">

                        <Image Source="pack://application:,,,/PurchaseTicket.Desktop;component/Assets/Images/logo.png"
                               Height="155"
                               Stretch="Uniform"/>

                    </Border>

                    <TextBlock Text="Tickets de Compra"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>

                    <TextBlock Text="Sistema de tickets de compra"
                               Foreground="{StaticResource SidebarSecondaryTextBrush}"
                               FontSize="12"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <!-- Opciones del menú -->
                <StackPanel Margin="12,0,12,0">

                    <!-- Separador -->
                    <Border Height="1"
                            Background="#34606D"
                            Margin="8,0,8,18"/>

                    <!-- Inicio -->
                    <primitives:ToggleButton
                        Command="{Binding ShowHomeCommand}"
                        IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                        Style="{StaticResource SidebarToggleButtonStyle}"
                        Height="50"
                        Margin="0,0,0,6">

                        <StackPanel Orientation="Horizontal">

                            <Path Data="{StaticResource HomeIcon}"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  Width="22"
                                  Height="22"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Text="Inicio"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </primitives:ToggleButton>

                    <!-- Tickets de compra: pendiente -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            IsEnabled="False"
                            Height="50"
                            Margin="0,0,0,6">

                        <StackPanel Orientation="Horizontal">

                            <Path Data="{StaticResource TicketIcon}"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  Width="22"
                                  Height="22"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Text="Tickets de compra"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <!-- Proveedores -->
                    <primitives:ToggleButton
                        Command="{Binding ShowSuppliersCommand}"
                        IsChecked="{Binding IsSuppliersSelected, Mode=OneWay}"
                        Style="{StaticResource SidebarToggleButtonStyle}"
                        Height="50"
                        Margin="0,0,0,6">

                        <StackPanel Orientation="Horizontal">

                            <Path Data="{StaticResource SuppliersIcon}"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType=primitives:ToggleButton}}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  Width="22"
                                  Height="22"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Text="Proveedores"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </primitives:ToggleButton>

                    <!-- Materiales: pendiente -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            IsEnabled="False"
                            Height="50"
                            Margin="0,0,0,6">

                        <StackPanel Orientation="Horizontal">

                            <Path Data="{StaticResource MaterialsIcon}"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  Width="22"
                                  Height="22"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Text="Materiales"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <!-- Configuración: pendiente -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            IsEnabled="False"
                            Height="50"
                            Margin="0,0,0,6">

                        <StackPanel Orientation="Horizontal">

                            <Path Data="{StaticResource SettingsIcon}"
                                  Fill="Transparent"
                                  Stroke="{Binding Foreground,
                                      RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  Width="22"
                                  Height="22"
                                  Stretch="Uniform"
                                  Margin="0,0,12,0"/>

                            <TextBlock Text="Configuración"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Área de contenido -->
        <Grid Grid.Column="1"
              Background="{StaticResource ContentBrush}">

            <ContentControl
                Content="{Binding CurrentViewModel}"/>

        </Grid>

    </Grid>

</Window>