<Window x:Class="PurchaseTicket.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PurchaseTicket.Desktop.Views.Suppliers"
        Title="PurchaseTicket Automation"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        xmlns:homeVm="clr-namespace:PurchaseTicket.Desktop.ViewModels.Home"
        xmlns:homeViews="clr-namespace:PurchaseTicket.Desktop.Views.Home"
        xmlns:vm="clr-namespace:PurchaseTicket.Desktop.ViewModels.Suppliers">

    <Window.Resources>
        <DataTemplate DataType="{x:Type homeVm:HomeViewModel}">
            <homeViews:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <views:SuppliersView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <Border Grid.Column="0"
                Background="#1E293B">

            <DockPanel>

                <!-- Encabezado -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="20,25,20,30">

                    <TextBlock Text="PurchaseTicket"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Automation"
                               Foreground="#94A3B8"
                               FontSize="13"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Opciones del menú -->
                <StackPanel Margin="10,0,10,0">

                    <Button Content="Inicio"
                            Command="{Binding ShowHomeCommand}"
                            Height="45"
                            Margin="0,0,0,5"/>

                    <Button Content="Tickets de compra"
                            Height="45"
                            Margin="0,0,0,5"/>

                    <Button Content="Proveedores"
                            Command="{Binding ShowSuppliersCommand}"
                            Height="45"
                            Margin="0,0,0,5"/>

                    <Button Content="Materiales"
                            Height="45"
                            Margin="0,0,0,5"/>

                    <Button Content="Configuración"
                            Height="45"
                            Margin="0,0,0,5"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Área principal -->
        <Grid Grid.Column="1"
              Background="#F8FAFC">

            <ContentControl Content="{Binding CurrentViewModel}"/>

        </Grid>

    </Grid>
</Window>
