<Window x:Class="PurchaseTicket.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:PurchaseTicket.Desktop.Components.Layout"
        xmlns:homeVm="clr-namespace:PurchaseTicket.Desktop.ViewModels.Home"
        xmlns:homeViews="clr-namespace:PurchaseTicket.Desktop.Views.Home"
        xmlns:suppliersVm="clr-namespace:PurchaseTicket.Desktop.ViewModels.Suppliers"
        xmlns:suppliersViews="clr-namespace:PurchaseTicket.Desktop.Views.Suppliers"
        xmlns:materialsVm="clr-namespace:PurchaseTicket.Desktop.ViewModels.Materials"
        xmlns:materialsViews="clr-namespace:PurchaseTicket.Desktop.Views.Materials"
        xmlns:weighingVm="clr-namespace:PurchaseTicket.Desktop.ViewModels.VehicleWeighing"
        xmlns:weighingViews="clr-namespace:PurchaseTicket.Desktop.Views.VehicleWeighing"
        xmlns:amountsVm="clr-namespace:PurchaseTicket.Desktop.ViewModels.Amounts"
        xmlns:amountsViews="clr-namespace:PurchaseTicket.Desktop.Views.Amounts"
        xmlns:ticketsVm="clr-namespace:PurchaseTicket.Desktop.ViewModels.Tickets"
        xmlns:ticketsViews="clr-namespace:PurchaseTicket.Desktop.Views.Tickets"
        xmlns:settingsVm="clr-namespace:PurchaseTicket.Desktop.ViewModels.Settings"
        xmlns:settingsView="clr-namespace:PurchaseTicket.Desktop.Views.Settings"
        xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
        Title="EcoPapel Recycling | Tickets de Compra"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Plantilla de inicio -->
        <DataTemplate DataType="{x:Type homeVm:HomeViewModel}">
            <homeViews:HomeView/>
        </DataTemplate>

        <!-- Plantilla de proveedores -->
        <DataTemplate DataType="{x:Type suppliersVm:SuppliersViewModel}">
            <suppliersViews:SuppliersView/>
        </DataTemplate>

        <!-- Plantilla de materiales -->
        <DataTemplate DataType="{x:Type materialsVm:MaterialsViewModel}">
            <materialsViews:MaterialsView/>
        </DataTemplate>

        <!-- Plantilla de pesaje de vehiculos -->
        <DataTemplate DataType="{x:Type weighingVm:VehicleWeighingViewModel}">
            <weighingViews:VehicleWeighingView/>
        </DataTemplate>

        <!-- Pantalla de importes -->
        <DataTemplate DataType="{x:Type amountsVm:TicketAmountsViewModel}">
            <amountsViews:TicketAmountsView/>
        </DataTemplate>

        <!-- Pantalla de tickets -->
        <DataTemplate DataType="{x:Type ticketsVm:TicketsViewModel}">
            <ticketsViews:TicketsView/>
        </DataTemplate>

        <!-- Pantalla de configuracion -->
        <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
            <settingsView:SettingsView/>
        </DataTemplate>

    </Window.Resources>

    <!-- Estructura principal -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral reutilizable -->
        <layout:Sidebar Grid.Column="0"/>

        <!-- Area principal -->
        <Grid Grid.Column="1"
              Background="{StaticResource ContentBrush}">

            <ContentControl Content="{Binding CurrentViewModel}"/>

            <!-- Pila de avisos: los nuevos aparecen abajo. Fuera de los avisos
                 el fondo es nulo, asi que los clics pasan a la pantalla -->
            <ItemsControl x:Name="NotificationHost"
                          ItemsSource="{Binding Toasts}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,40"
                          Focusable="False">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <feedback:Toast Message="{Binding Message}"
                                        Kind="{Binding Kind}"
                                        CloseCommand="{Binding CloseCommand}"
                                        Margin="0,8,0,0"/>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </Grid>

    </Grid>

</Window>