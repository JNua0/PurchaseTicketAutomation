<UserControl x:Class="PurchaseTicket.Desktop.Views.Suppliers.SupplierTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actions="clr-namespace:PurchaseTicket.Desktop.Components.Actions"
             xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback">

    <!-- Tabla de proveedores -->
    <DataGrid Style="{StaticResource AppDataGridStyle}"
              ItemsSource="{Binding Suppliers}"
              SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}">

        <DataGrid.Columns>

            <!-- Identificador del proveedor -->
            <DataGridTextColumn Header="ID"
                                Binding="{Binding Id}"
                                Width="75"
                                MinWidth="75"/>

            <!-- Nombre del proveedor -->
            <DataGridTextColumn Header="Proveedor"
                                Binding="{Binding Name}"
                                Width="2*"
                                MinWidth="220"/>

            <!-- Numero telefonico -->
            <DataGridTextColumn Header="Teléfono"
                                Binding="{Binding PhoneNumber,
                                                  TargetNullValue=Sin registrar}"
                                Width="*"
                                MinWidth="160"/>

            <!-- Estado del proveedor -->
            <DataGridTemplateColumn Header="Estado"
                                    Width="120"
                                    MinWidth="120">

                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>

                        <feedback:StatusBadge
                            Style="{StaticResource ActiveStatusBadgeStyle}"/>

                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>

            </DataGridTemplateColumn>

            <!-- Acciones individuales del proveedor -->
            <DataGridTemplateColumn Header="Acciones"
                                    Width="120"
                                    MinWidth="120"
                                    MaxWidth="120"
                                    CanUserResize="False">

                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Editar proveedor -->
                            <actions:EditActionButton
                                Command="{Binding DataContext.EditSupplierCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"
                                ToolTip="Editar proveedor"
                                Margin="0,0,8,0"/>

                            <!-- Activar o desactivar proveedor -->
                            <actions:StatusActionButton
                                IsActive="{Binding IsActive}"
                                ActivateIcon="{StaticResource ActivateUserIcon}"
                                DeactivateIcon="{StaticResource DeactivateUserIcon}"
                                Command="{Binding DataContext.ChangeSupplierStatusCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>

            </DataGridTemplateColumn>

        </DataGrid.Columns>

    </DataGrid>

</UserControl>