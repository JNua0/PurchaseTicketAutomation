<UserControl x:Class="PurchaseTicket.Desktop.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actions="clr-namespace:PurchaseTicket.Desktop.Components.Actions"
             xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
             xmlns:layout="clr-namespace:PurchaseTicket.Desktop.Components.Layout"
             xmlns:settings="clr-namespace:PurchaseTicket.Desktop.Views.Settings">

    <layout:PageLayout>

        <layout:PageLayout.PageContent>

            <!-- Solo se desplaza en pantallas bajas -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">

                <StackPanel>

                    <!-- Bloque 1: Encabezado -->
                    <layout:PageHeader Title="{Binding Title}"
                                       Description="{Binding Description}"/>

                    <!-- Bloque 2: Dispositivos -->
                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Bottom">

                            <TextBlock Text="DISPOSITIVOS"
                                       Style="{StaticResource FormSectionTitleStyle}"
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding DetectionSummary}"
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </StackPanel>

                        <!-- Secundario: la accion principal de la pantalla es elegir el puerto -->
                        <actions:ActionButton Grid.Column="1"
                                              Text="Actualizar puertos"
                                              Icon="{StaticResource RefreshIcon}"
                                              Variant="Secondary"
                                              Command="{Binding RefreshPortsCommand}"
                                              VerticalAlignment="Bottom"/>

                    </Grid>

                    <Grid Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <settings:DevicePortCard Grid.Column="0"
                                                 DataContext="{Binding Printer}"/>

                        <settings:DevicePortCard Grid.Column="2"
                                                 DataContext="{Binding WeightIndicator}"/>

                    </Grid>

                    <!-- Bloque 3: Encabezado del ticket -->
                    <TextBlock Text="ENCABEZADO DEL TICKET"
                               Style="{StaticResource FormSectionTitleStyle}"/>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="22,20">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vista previa con la fuente y el ancho del papel -->
                            <Grid Grid.Column="0"
                                  VerticalAlignment="Center">

                                <Rectangle Fill="#FBFBF7"
                                           Stroke="#C9D3D9"
                                           StrokeDashArray="4 3"
                                           RadiusX="6"
                                           RadiusY="6"/>

                                <TextBlock Text="{Binding HeaderPreview}"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           LineHeight="19"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Margin="16,14"/>

                            </Grid>

                            <StackPanel Grid.Column="1"
                                        Margin="28,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Así se imprime en cada ticket"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>

                                <TextBlock Text="Nombre, dirección, colonia, teléfono y correo de la empresa. Cada línea admite hasta 35 caracteres, el ancho del papel. Las líneas vacías no se imprimen."
                                           FontSize="14"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>

                                <actions:ActionButton Text="Editar encabezado"
                                                      Icon="{StaticResource EditIcon}"
                                                      Variant="Secondary"
                                                      Command="{Binding EditHeaderCommand}"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,16,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- Bloque 4: Respaldos -->
                    <TextBlock Text="RESPALDOS"
                               Style="{StaticResource FormSectionTitleStyle}"
                               Margin="0,24,0,8"/>

                    <Border DataContext="{Binding Backup}"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="22,20">

                        <StackPanel>

                            <!-- Titulo, descripcion y estado -->
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="Respaldo de la base de datos"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"/>

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                                <feedback:StatusBadge Grid.Column="1"
                                                      Text="{Binding StatusText}"
                                                      Kind="{Binding StatusKind}"
                                                      Margin="16,0,0,0"
                                                      VerticalAlignment="Top"/>

                            </Grid>

                            <!-- Ultimo respaldo, tamano y carpeta -->
                            <Grid Margin="0,16,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,16,0">
                                    <TextBlock Text="Último respaldo"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding LastBackupText}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="0,0,16,0">
                                    <TextBlock Text="Tamaño"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding SizeText}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Carpeta"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding Folder}"
                                               ToolTip="{Binding Folder}"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                            </Grid>

                            <!-- Motivo del ultimo fallo, como una USB desconectada -->
                            <Border Background="{StaticResource ErrorSoftBrush}"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,14,0,0"
                                    Visibility="{Binding HasError,
                                                         Converter={StaticResource BoolToVisibility}}">

                                <TextBlock Text="{Binding ErrorMessage}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource ErrorBrush}"/>

                            </Border>

                            <!-- Recomendacion y acciones -->
                            <Border BorderBrush="{StaticResource BorderBrushLight}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,14,0,0"
                                    Margin="0,16,0,0">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Elige una carpeta en otro disco o en una USB: si falla la PC, el respaldo sigue a salvo."
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,0,16,0"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">

                                        <actions:ActionButton Text="Cambiar carpeta"
                                                              Icon="{StaticResource FolderIcon}"
                                                              Variant="Secondary"
                                                              Command="{Binding ChangeFolderCommand}"/>

                                        <actions:ActionButton Text="Abrir carpeta"
                                                              Variant="Simple"
                                                              Command="{Binding OpenFolderCommand}"
                                                              Margin="10,0,0,0"/>

                                        <actions:ActionButton Text="Respaldar ahora"
                                                              Icon="{StaticResource BackupIcon}"
                                                              Variant="Primary"
                                                              Command="{Binding BackupNowCommand}"
                                                              Margin="10,0,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </layout:PageLayout.PageContent>

    </layout:PageLayout>

</UserControl>