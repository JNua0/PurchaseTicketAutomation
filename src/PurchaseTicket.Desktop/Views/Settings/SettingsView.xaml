<UserControl x:Class="PurchaseTicket.Desktop.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30">

            <!-- Encabezado -->
            <TextBlock Text="{Binding Title}"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Text="{Binding Description}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- Actualizar puertos -->
            <Button Content="Actualizar puertos"
                    Command="{Binding RefreshPortsCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Left"
                    MinWidth="150"
                    Height="36"
                    Margin="0,0,0,24"/>

            <!-- Tarjetas lado a lado -->
            <Grid Margin="0,0,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Configuracion de impresora -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Impresora"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Configura el puerto de comunicación de la impresora Epson TM-U295."
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- Puerto de la impresora -->
                        <TextBlock Text="Puerto COM"
                                   FontWeight="SemiBold"
                                   Margin="0,20,0,6"/>

                        <ComboBox ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPrinterPort, Mode=TwoWay}"
                                  Height="36"
                                  MinWidth="200"
                                  HorizontalAlignment="Left"/>


                        <!-- Estado del puerto -->
                        <Grid Margin="0,12,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Indicador de disponibilidad -->
                            <Ellipse Grid.Column="0"
                                     Width="9"
                                     Height="9"
                                     Margin="0,4,10,0"
                                     VerticalAlignment="Top">

                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">

                                        <Setter Property="Fill"
                                                Value="#D97706"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPrinterPortAvailable}"
                                                         Value="True">
                                                <Setter Property="Fill"
                                                        Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>

                                    </Style>
                                </Ellipse.Style>

                            </Ellipse>

                            <!-- Mensaje de disponibilidad -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PrinterPortStatus}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"/>

                        </Grid>


                    </StackPanel>

                </Border>

                <!-- Configuracion del indicador -->
                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Indicador de peso"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Configura el puerto de comunicación del indicador Dini Argeo."
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- Puerto del indicador -->
                        <TextBlock Text="Puerto COM"
                                   FontWeight="SemiBold"
                                   Margin="0,20,0,6"/>

                        <ComboBox ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedWeightIndicatorPort, Mode=TwoWay}"
                                  Height="36"
                                  MinWidth="200"
                                  HorizontalAlignment="Left"/>

                        <!-- Estado del puerto -->
                        <Grid Margin="0,12,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Indicador de disponibilidad -->
                            <Ellipse Grid.Column="0"
                                     Width="9"
                                     Height="9"
                                     Margin="0,4,10,0"
                                     VerticalAlignment="Top">

                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#D97706"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeightIndicatorPortAvailable}"
                                                         Value="True">
                                                <Setter Property="Fill" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>

                            </Ellipse>

                            <!-- Mensaje de disponibilidad -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding WeightIndicatorPortStatus}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"/>

                        </Grid>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- Encabezado de tickets -->
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="Encabezado del ticket"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Administra la información de la empresa que aparecerá en los comprobantes."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <!-- Nombre de la empresa -->
                    <TextBlock Text="Nombre de la empresa"
                               FontWeight="SemiBold"
                               Margin="0,20,0,6"/>

                    <TextBox Text="{Binding TicketHeader.CompanyName,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,16"/>

                    <!-- Direccion -->
                    <TextBlock Text="Dirección"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Text="{Binding TicketHeader.Address,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,16"/>

                    <!-- Colonia -->
                    <TextBlock Text="Colonia"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Text="{Binding TicketHeader.Neighborhood,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,16"/>

                    <!-- Telefono -->
                    <TextBlock Text="Teléfono"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Text="{Binding TicketHeader.PhoneNumber,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,16"/>

                    <!-- Correo electronico -->
                    <TextBlock Text="Correo electrónico"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Text="{Binding TicketHeader.Email,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                </StackPanel>

            </Border>

            <!-- Mensaje de confirmacion -->
            <TextBlock Text="{Binding SuccessMessage}"
                       Foreground="#2E7D32"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,8,0,8">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                                Value="Visible"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SuccessMessage}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding SuccessMessage}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

            <!-- Mensaje de error -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#D32F2F"
                       TextWrapping="Wrap"
                       Margin="0,8,0,8">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                                Value="Visible"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ErrorMessage}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

            <!-- Guardar configuracion -->
            <Button Content="Guardar configuración"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right"
                    MinWidth="190"
                    Height="38"
                    Margin="0,16,0,0"/>

        </StackPanel>

    </ScrollViewer>

</UserControl>