<UserControl x:Class="PurchaseTicket.Desktop.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:PurchaseTicket.Desktop.Components.Layout"
             xmlns:settings="clr-namespace:PurchaseTicket.Desktop.Views.Settings">

    <layout:PageLayout>

        <layout:PageLayout.PageContent>

            <!-- Solo se desplaza en pantallas bajas -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">

                <StackPanel>

                    <!-- Bloque 1: Encabezado -->
                    <layout:PageHeader Title="{Binding Title}"
                                       Description="{Binding Description}"/>

                    <!-- Bloque 2: Dispositivos -->
                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Bottom">

                            <TextBlock Text="DISPOSITIVOS"
                                       Style="{StaticResource FormSectionTitleStyle}"
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding DetectionSummary}"
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </StackPanel>

                        <!-- Secundario: la accion principal de la pantalla es elegir el puerto -->
                        <Button Grid.Column="1"
                                Command="{Binding RefreshPortsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="38"
                                VerticalAlignment="Bottom">

                            <StackPanel Orientation="Horizontal">

                                <Path Data="{StaticResource RefreshIcon}"
                                      Width="15"
                                      Height="15"
                                      Margin="0,0,8,0"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource PrimaryTextBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center"/>

                                <TextBlock Text="Actualizar puertos"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                    <Grid Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <settings:DevicePortCard Grid.Column="0"
                                                 DataContext="{Binding Printer}"/>

                        <settings:DevicePortCard Grid.Column="2"
                                                 DataContext="{Binding WeightIndicator}"/>

                    </Grid>

                    <!-- Bloque 3: Encabezado del ticket -->
                    <TextBlock Text="ENCABEZADO DEL TICKET"
                               Style="{StaticResource FormSectionTitleStyle}"/>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushLight}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="22,20">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vista previa con la fuente y el ancho del papel -->
                            <Grid Grid.Column="0"
                                  VerticalAlignment="Center">

                                <Rectangle Fill="#FBFBF7"
                                           Stroke="#C9D3D9"
                                           StrokeDashArray="4 3"
                                           RadiusX="6"
                                           RadiusY="6"/>

                                <TextBlock Text="{Binding HeaderPreview}"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           LineHeight="19"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Margin="16,14"/>

                            </Grid>

                            <StackPanel Grid.Column="1"
                                        Margin="28,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Así se imprime en cada ticket"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>

                                <TextBlock Text="Nombre, dirección, colonia, teléfono y correo de la empresa. Cada línea admite hasta 35 caracteres, el ancho del papel. Las líneas vacías no se imprimen."
                                           FontSize="14"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>

                                <Button Command="{Binding EditHeaderCommand}"
                                        Style="{StaticResource OutlinePrimaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0">

                                    <StackPanel Orientation="Horizontal">

                                        <Path Data="{StaticResource EditIcon}"
                                              Width="15"
                                              Height="15"
                                              Margin="0,0,8,0"
                                              Stretch="Uniform"
                                              Stroke="{StaticResource EcoBlueDarkBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              VerticalAlignment="Center"/>

                                        <TextBlock Text="Editar encabezado"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>

                            </StackPanel>

                        </Grid>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </layout:PageLayout.PageContent>

    </layout:PageLayout>

</UserControl>