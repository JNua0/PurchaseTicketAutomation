<UserControl x:Class="PurchaseTicket.Desktop.Views.Tickets.TicketsFiltersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actions="clr-namespace:PurchaseTicket.Desktop.Components.Actions"
             xmlns:filters="clr-namespace:PurchaseTicket.Desktop.Components.Filters"
             xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
             x:Name="Root">

    <!-- Busqueda siempre visible; el resto de los filtros se pliega. Cerrados,
         los filtros activos se ven como etiquetas para no filtrar en silencio -->
    <UserControl.Resources>

        <!-- Cambiar un filtro durante la carga mezclaria dos consultas -->
        <Style x:Key="FiltersRowStyle"
               TargetType="Grid">

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsLoading}"
                             Value="True">
                    <Setter Property="IsEnabled"
                            Value="False"/>
                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="FilterLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Margin"
                    Value="0,0,0,7"/>
        </Style>

        <Style x:Key="FilterDatePickerStyle"
               TargetType="DatePicker">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrushLight}"/>
        </Style>

        <!-- La × de una etiqueta: solo el icono, con fondo al pasar el mouse -->
        <Style x:Key="ChipRemoveButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="20"/>
            <Setter Property="Height"
                    Value="20"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ChipBackground"
                                Background="Transparent"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ChipBackground"
                                        Property="Background"
                                        Value="{StaticResource BorderBrushLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <StackPanel>

        <!-- Fila 1: busqueda y boton de filtros -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <filters:SearchBox Grid.Column="0"
                               Label="Buscar ticket"
                               SearchText="{Binding SearchText, Mode=TwoWay}"
                               SearchCommand="{Binding SearchCommand}"
                               IsLoading="{Binding IsLoading}"/>

            <actions:ActionButton Grid.Column="2"
                                  Text="Filtros"
                                  Icon="{StaticResource FilterIcon}"
                                  Variant="Secondary"
                                  Command="{Binding ToggleFiltersCommand}"
                                  VerticalAlignment="Bottom">

                <actions:ActionButton.TrailingContent>
                    <StackPanel Orientation="Horizontal">

                        <!-- Numero de filtros activos; sin filtros no se muestra -->
                        <Border Margin="8,0,0,0"
                                MinWidth="20"
                                Height="20"
                                Padding="6,0"
                                CornerRadius="10"
                                Background="{StaticResource InfoBrush}"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasActiveFilters,
                                                     Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="{Binding ActiveFilterCount}"
                                       FontSize="12"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <!-- Flecha hacia abajo cerrado, hacia arriba abierto -->
                        <Path Width="10"
                              Height="10"
                              Margin="8,0,0,0"
                              Stretch="Uniform"
                              Stroke="{StaticResource EcoBlueDarkBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              VerticalAlignment="Center">

                            <Path.Style>
                                <Style TargetType="Path">

                                    <Setter Property="Data"
                                            Value="{StaticResource ChevronDownIcon}"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiltersExpanded}"
                                                     Value="True">
                                            <Setter Property="Data"
                                                    Value="{StaticResource ChevronUpIcon}"/>
                                        </DataTrigger>
                                    </Style.Triggers>

                                </Style>
                            </Path.Style>

                        </Path>

                    </StackPanel>
                </actions:ActionButton.TrailingContent>

            </actions:ActionButton>

        </Grid>

        <!-- Fila 2, con el panel cerrado: etiquetas de los filtros activos -->
        <Grid Margin="0,12,0,0"
              Visibility="{Binding ShowsActiveFilters,
                                   Converter={StaticResource BoolToVisibility}}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0"
                          ItemsSource="{Binding ActiveFilters}"
                          Focusable="False">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Height="28"
                                Margin="0,0,8,0"
                                Padding="12,0,4,0"
                                CornerRadius="14"
                                Background="{StaticResource InfoSoftBrush}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding Label, StringFormat={}{0}:}"
                                           FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Value}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InfoBrush}"
                                           Margin="4,0,4,0"
                                           VerticalAlignment="Center"/>

                                <Button Command="{Binding DataContext.RemoveFilterCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ChipRemoveButtonStyle}"
                                        ToolTip="Quitar filtro"
                                        VerticalAlignment="Center">

                                    <Path Data="{StaticResource CloseIcon}"
                                          Width="9"
                                          Height="9"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource InfoBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>

                                </Button>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <Button Grid.Column="1"
                    Content="Limpiar filtros"
                    Command="{Binding ClearFiltersCommand}"
                    Style="{StaticResource LinkButtonStyle}"
                    FontSize="13"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"/>

        </Grid>

        <!-- Fila 2, con el panel abierto: todos los filtros -->
        <Border Margin="0,14,0,0"
                Padding="0,14,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BorderBrushLight}"
                Visibility="{Binding IsFiltersExpanded,
                                     Converter={StaticResource BoolToVisibility}}">

            <StackPanel>

                <!-- Periodo; Desde y Hasta solo con un periodo personalizado -->
                <Grid Style="{StaticResource FiltersRowStyle}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Periodo"
                                   Style="{StaticResource FilterLabelStyle}"/>

                        <ComboBox ItemsSource="{Binding PeriodOptions}"
                                  SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource ComboBoxStyle}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Visibility="{Binding IsCustomPeriod,
                                                     Converter={StaticResource BoolToVisibility}}">

                        <StackPanel Width="190"
                                    Margin="12,0,0,0">

                            <TextBlock Text="Desde"
                                       Style="{StaticResource FilterLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                        Style="{StaticResource FilterDatePickerStyle}"/>

                        </StackPanel>

                        <StackPanel Width="190"
                                    Margin="12,0,0,0">

                            <TextBlock Text="Hasta"
                                       Style="{StaticResource FilterLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                        Style="{StaticResource FilterDatePickerStyle}"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

                <!-- Catalogos, estado y modalidad -->
                <Grid Margin="0,14,0,0"
                      Style="{StaticResource FiltersRowStyle}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Proveedor"
                                   Style="{StaticResource FilterLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding SupplierOptions}"
                                  SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Material"
                                   Style="{StaticResource FilterLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding MaterialOptions}"
                                  SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Estado"
                                   Style="{StaticResource FilterLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Modalidad"
                                   Style="{StaticResource FilterLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding WeighingTypeOptions}"
                                  SelectedItem="{Binding SelectedWeighingType, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="8"
                            Content="Limpiar filtros"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource LinkButtonStyle}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,9"/>

                </Grid>

            </StackPanel>

        </Border>

        <!-- Rango invertido: no se consulta hasta corregirlo -->
        <TextBlock Text="{Binding DateRangeError}"
                   FontSize="12"
                   Foreground="{StaticResource ErrorBrush}"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasDateRangeError,
                                        Converter={StaticResource BoolToVisibility}}"/>

        <feedback:QueryStatus Margin="0,12,0,0"
                              IsLoading="{Binding IsLoading}"
                              LoadingMessage="Cargando tickets..."
                              ErrorMessage="{Binding QueryErrorMessage}"/>

    </StackPanel>

</UserControl>