<Window x:Class="PurchaseTicket.Desktop.Views.VehicleWeighing.CreateWeighingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:forms="clr-namespace:PurchaseTicket.Desktop.Components.Forms"
        xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
        Title="{Binding Title}"
        Width="720"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <forms:DialogLayout Title="{Binding Title}"
                        Description="{Binding Description}">

        <!-- Campos del formulario -->
        <forms:DialogLayout.BodyContent>

            <StackPanel>

                <!-- Campos bloqueados mientras se registra -->
                <StackPanel>

                    <StackPanel.Style>
                        <Style TargetType="StackPanel">

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsSaving}"
                                             Value="True">
                                    <Setter Property="IsEnabled"
                                            Value="False"/>
                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </StackPanel.Style>

                    <!-- Tipo de pesaje -->
                    <TextBlock Text="Tipo de pesaje"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,0,0,7"/>

                    <!-- Al editar queda fijo, pero visible para saber que se corrige -->
                    <ListBox Style="{StaticResource SegmentedSelectorStyle}"
                             IsEnabled="{Binding CanChangeWeighingType}"
                             ItemsSource="{Binding WeighingTypeOptions}"
                             SelectedValuePath="Value"
                             SelectedValue="{Binding SelectedWeighingType, Mode=TwoWay}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <StackPanel Margin="0,8">

                                    <TextBlock Text="{Binding Title}"
                                               HorizontalAlignment="Center"/>

                                    <!-- Explica la opcion; queda gris aun seleccionada -->
                                    <TextBlock Text="{Binding Description}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,2,0,0"/>

                                </StackPanel>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Datos de la operacion -->
                    <TextBlock Text="DATOS DE LA OPERACIÓN"
                               Style="{StaticResource FormSectionTitleStyle}"/>

                    <Grid Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <forms:FormComboField Grid.Column="0"
                                              Label="Proveedor"
                                              IsRequired="True"
                                              Placeholder="Selecciona un proveedor"
                                              ItemsSource="{Binding Suppliers}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedSupplierId, Mode=TwoWay}"
                                              Margin="0,0,14,0"/>

                        <forms:FormComboField Grid.Column="1"
                                              Label="Material"
                                              IsRequired="True"
                                              Placeholder="Selecciona un material"
                                              ItemsSource="{Binding Materials}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedMaterialId, Mode=TwoWay}"/>

                    </Grid>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Obligatorias en el convencional, opcionales en el unico -->
                        <forms:FormTextField Grid.Column="0"
                                             Label="Placas"
                                             IsRequired="{Binding IsConventional}"
                                             Text="{Binding LicensePlate,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="7"
                                             CharacterCasing="Upper"
                                             Margin="0,0,14,0"/>

                        <forms:FormTextField Grid.Column="1"
                                             Label="Transportista"
                                             IsRequired="True"
                                             Text="{Binding Transporter,
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="50"/>

                    </Grid>

                    <!-- Peso -->
                    <TextBlock Text="{Binding WeightSectionTitle}"
                               Style="{StaticResource FormSectionTitleStyle}"/>

                    <forms:WeightCaptureField Label="{Binding WeightLabel}"
                                              Capture="{Binding Weight}"/>

                </StackPanel>

                <!-- Errores generales, como fallas de conexion -->
                <feedback:QueryStatus Margin="0,14,0,0"
                                      IsLoading="{Binding IsLoadingCatalogs}"
                                      LoadingMessage="Cargando proveedores y materiales..."
                                      ErrorMessage="{Binding ErrorMessage}"/>

            </StackPanel>

        </forms:DialogLayout.BodyContent>

        <!-- Opcion de impresion -->
        <forms:DialogLayout.FooterContent>

            <CheckBox Content="Imprimir ticket al registrar"
                      IsChecked="{Binding PrintOnSave}"
                      Visibility="{Binding ShowsPrintOption,
                                           Converter={StaticResource BoolToVisibility}}"
                      FontSize="14"
                      VerticalContentAlignment="Center"
                      Foreground="{StaticResource PrimaryTextBrush}"/>

        </forms:DialogLayout.FooterContent>

        <!-- Cancelar y registrar -->
        <forms:DialogLayout.Actions>

            <forms:FormActions SaveButtonText="{Binding SaveButtonText}"
                               SaveCommand="{Binding SaveCommand}"
                               CancelCommand="{Binding CancelCommand,
                                                       RelativeSource={RelativeSource AncestorType=Window}}"
                               IsSaving="{Binding IsSaving}"/>

        </forms:DialogLayout.Actions>

    </forms:DialogLayout>

</Window>