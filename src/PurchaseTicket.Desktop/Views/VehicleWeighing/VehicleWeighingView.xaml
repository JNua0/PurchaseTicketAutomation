<UserControl x:Class="PurchaseTicket.Desktop.Views.VehicleWeighing.VehicleWeighingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:PurchaseTicket.Desktop.Components.Layout"
             xmlns:actions="clr-namespace:PurchaseTicket.Desktop.Components.Actions"
             xmlns:pagination="clr-namespace:PurchaseTicket.Desktop.Components.Pagination"
             xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
             xmlns:weighing="clr-namespace:PurchaseTicket.Desktop.Views.VehicleWeighing">

    <!-- Estructura principal -->
    <layout:PageLayout>

        <layout:PageLayout.PageContent>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bloque 1: Encabezado; la descripcion cambia con la vista -->
                <layout:PageHeader Grid.Row="0"
                                   Title="Pesaje de vehículos"
                                   Description="{Binding ViewDescription}">

                    <layout:PageHeader.Actions>

                        <actions:ActionButton Text="Nuevo pesaje"
                                              Icon="{StaticResource PlusIcon}"
                                              Variant="Success"
                                              Command="{Binding NewWeighingCommand}"/>

                    </layout:PageHeader.Actions>

                </layout:PageHeader>

                <!-- Bloque 2: Busqueda y selector de vista -->
                <layout:FilterCard Grid.Row="1"
                                   Margin="0,0,0,20">

                    <layout:FilterCard.FilterContent>

                        <weighing:WeighingFiltersView/>

                    </layout:FilterCard.FilterContent>

                </layout:FilterCard>

                <!-- Bloque 3: Tabla y paginacion -->
                <layout:DataCard Grid.Row="2">

                    <layout:DataCard.DataContent>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Una tabla por vista: sus columnas son distintas -->
                            <weighing:InPlantTableView
                                Grid.Row="0"
                                Visibility="{Binding IsInPlantView,
                                                     Converter={StaticResource BoolToVisibility}}"/>

                            <weighing:SinglesTodayTableView Grid.Row="0">

                                <!-- Visible cuando no es la vista en planta -->
                                <weighing:SinglesTodayTableView.Style>
                                    <Style TargetType="weighing:SinglesTodayTableView">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsInPlantView}"
                                                         Value="False">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </weighing:SinglesTodayTableView.Style>

                            </weighing:SinglesTodayTableView>

                            <!-- Mensaje de tabla vacia, debajo de los encabezados -->
                            <feedback:EmptyState
                                Grid.Row="0"
                                Margin="0,42,0,0"
                                Message="{Binding EmptyMessage}"
                                Visibility="{Binding IsEmpty,
                                                     Converter={StaticResource BoolToVisibility}}"/>

                            <!-- Controles de paginacion -->
                            <pagination:PaginationControl
                                Grid.Row="1"
                                Margin="0,16,0,0"
                                TotalCount="{Binding TotalCount}"
                                CurrentPage="{Binding CurrentPage}"
                                TotalPages="{Binding TotalPages}"
                                PageSize="{Binding PageSize, Mode=TwoWay}"
                                PageSizeOptions="{Binding PageSizeOptions}"
                                ChangePageSizeCommand="{Binding ChangePageSizeCommand}"
                                PreviousPageCommand="{Binding PreviousPageCommand}"
                                NextPageCommand="{Binding NextPageCommand}"/>

                        </Grid>

                    </layout:DataCard.DataContent>

                </layout:DataCard>

            </Grid>

        </layout:PageLayout.PageContent>

    </layout:PageLayout>

</UserControl>
