<UserControl x:Class="PurchaseTicket.Desktop.Views.VehicleWeighing.VehicleWeighingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:PurchaseTicket.Desktop.Components.Layout"
             xmlns:actions="clr-namespace:PurchaseTicket.Desktop.Components.Actions"
             xmlns:pagination="clr-namespace:PurchaseTicket.Desktop.Components.Pagination"
             xmlns:filters="clr-namespace:PurchaseTicket.Desktop.Components.Filters">

    <!-- Estructura principal -->
    <layout:PageLayout>

        <layout:PageLayout.PageContent>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <layout:PageHeader
                    Grid.Row="0"
                    Title="Pesaje de vehículos"
                    Description="Registro y control de pesajes de vehículos">

                    <layout:PageHeader.Actions>

                        <actions:CreateActionButton
                            Text="Nuevo pesaje"
                            Command="{Binding NewWeighingCommand}"/>

                    </layout:PageHeader.Actions>

                </layout:PageHeader>

                <!-- Filtros de busqueda -->
                <layout:FilterCard
                    Grid.Row="1"
                    Margin="0,0,0,20">

                    <layout:FilterCard.FilterContent>

                        <filters:SearchBox
                            Label="Buscar ticket"
                            SearchText="{Binding SearchText, Mode=TwoWay}"
                            SearchCommand="{Binding SearchTicketsCommand}"
                            IsLoading="{Binding IsLoading}"/>

                    </layout:FilterCard.FilterContent>

                </layout:FilterCard>

                <!-- Tabla y paginacion -->
                <layout:DataCard Grid.Row="2">

                    <layout:DataCard.DataContent>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0"
                                      Style="{StaticResource AppDataGridStyle}"
                                      ItemsSource="{Binding Tickets}"
                                      SelectedItem="{Binding SelectedTicket, Mode=TwoWay}">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="Folio"
                                        Binding="{Binding TicketNumber}"
                                        Width="140"/>

                                    <DataGridTextColumn
                                        Header="Fecha de entrada"
                                        Binding="{Binding CheckInAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="165"/>

                                    <DataGridTextColumn
                                        Header="Placas"
                                        Binding="{Binding LicensePlate}"
                                        Width="120"/>

                                    <DataGridTextColumn
                                        Header="Transportista"
                                        Binding="{Binding Transporter}"
                                        Width="*"
                                        MinWidth="170"/>

                                    <DataGridTextColumn
                                        Header="Peso bruto (kg)"
                                        Binding="{Binding GrossWeight, StringFormat={}{0:N2}}"
                                        Width="150"/>

                                    <DataGridTemplateColumn
                                        Header="Acciones"
                                        Width="145"
                                        CanUserResize="False">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <Button
                                                    Content="Registrar tara"
                                                    Command="{Binding DataContext.RegisterTareCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButtonStyle}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                            <pagination:PaginationControl
                                Grid.Row="1"
                                Margin="0,16,0,0"
                                TotalCount="{Binding TotalCount}"
                                CurrentPage="{Binding CurrentPage}"
                                TotalPages="{Binding TotalPages}"
                                PageSize="{Binding PageSize, Mode=TwoWay}"
                                PageSizeOptions="{Binding PageSizeOptions}"
                                ChangePageSizeCommand="{Binding ChangePageSizeCommand}"
                                PreviousPageCommand="{Binding PreviousPageCommand}"
                                NextPageCommand="{Binding NextPageCommand}"/>

                        </Grid>

                    </layout:DataCard.DataContent>

                </layout:DataCard>

            </Grid>

        </layout:PageLayout.PageContent>

    </layout:PageLayout>

</UserControl>
