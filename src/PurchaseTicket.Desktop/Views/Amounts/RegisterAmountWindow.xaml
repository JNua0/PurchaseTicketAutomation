<Window x:Class="PurchaseTicket.Desktop.Views.Amounts.RegisterAmountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:forms="clr-namespace:PurchaseTicket.Desktop.Components.Forms"
        xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
        Title="Registrar importe"
        Width="640"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBrush}"
        Closing="Window_Closing">

    <forms:DialogLayout Title="Registrar importe"
                        Description="{Binding Description}">

        <!-- Estado actual del ticket -->
        <forms:DialogLayout.HeaderContent>

            <feedback:StatusBadge Text="Pendiente de importe"
                                  Kind="Info"/>

        </forms:DialogLayout.HeaderContent>

        <forms:DialogLayout.BodyContent>

            <StackPanel>

                <!-- Campos bloqueados mientras se registra -->
                <StackPanel>

                    <StackPanel.Style>
                        <Style TargetType="StackPanel">

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsSaving}"
                                             Value="True">
                                    <Setter Property="IsEnabled"
                                            Value="False"/>
                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </StackPanel.Style>

                    <!-- Datos del ticket: primera seccion, sin margen superior -->
                    <TextBlock Text="DATOS DEL TICKET"
                               Style="{StaticResource FormSectionTitleStyle}"
                               Margin="0,0,0,12"/>

                    <forms:DetailList Items="{Binding Details}"/>

                    <!-- Descuento y precio -->
                    <TextBlock Text="IMPORTE"
                               Style="{StaticResource FormSectionTitleStyle}"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <forms:FormTextField Grid.Column="0"
                                             Label="Descuento (%)"
                                             IsRequired="True"
                                             FocusOnLoad="True"
                                             MaxLength="2"
                                             Text="{Binding DiscountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <forms:FormTextField Grid.Column="2"
                                             Label="Precio por kg ($)"
                                             IsRequired="True"
                                             MaxLength="12"
                                             Text="{Binding PricePerKgText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    </Grid>

                    <TextBlock Text="El descuento es un número entero de 0 a 99. El precio admite hasta dos decimales."
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,8,0,0"/>

                    <!-- Se recalcula mientras se escribe, con el mismo calculo que se guarda -->
                    <forms:CalculationBreakdown Steps="{Binding Breakdown}"
                                                IsVertical="True"
                                                Margin="0,16,0,0"/>

                </StackPanel>

                <!-- Errores generales, como un ticket que ya no esta pendiente -->
                <feedback:QueryStatus Margin="0,14,0,0"
                                      IsLoading="False"
                                      ErrorMessage="{Binding ErrorMessage}"/>

            </StackPanel>

        </forms:DialogLayout.BodyContent>

        <!-- Registrar el importe no imprime: el ticket solo lleva pesos (RN-48) -->
        <forms:DialogLayout.FooterContent>

            <TextBlock Text="El ticket quedará Completado"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"/>

        </forms:DialogLayout.FooterContent>

        <forms:DialogLayout.Actions>

            <forms:FormActions SaveButtonText="Registrar importe"
                               SaveCommand="{Binding SaveCommand}"
                               CancelCommand="{Binding CancelCommand,
                                                       RelativeSource={RelativeSource AncestorType=Window}}"
                               IsSaving="{Binding IsSaving}"/>

        </forms:DialogLayout.Actions>

    </forms:DialogLayout>

</Window>