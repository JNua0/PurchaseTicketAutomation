<UserControl x:Class="PurchaseTicket.Desktop.Views.Amounts.TicketAmountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:PurchaseTicket.Desktop.Components.Layout"
             xmlns:filters="clr-namespace:PurchaseTicket.Desktop.Components.Filters"
             xmlns:pagination="clr-namespace:PurchaseTicket.Desktop.Components.Pagination"
             xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
             xmlns:amounts="clr-namespace:PurchaseTicket.Desktop.Views.Amounts">

    <layout:PageLayout>

        <layout:PageLayout.PageContent>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bloque 1: Encabezado con el total pendiente -->
                <layout:PageHeader Grid.Row="0"
                                   Title="Importes de tickets"
                                   Description="{Binding Description}">

                    <layout:PageHeader.Actions>

                        <feedback:StatusBadge Text="{Binding PendingCountText}"
                                              Kind="Info"
                                              VerticalAlignment="Top"/>

                    </layout:PageHeader.Actions>

                </layout:PageHeader>

                <!-- Bloque 2: Busqueda; sin filtro de fechas, se ven todos los pendientes -->
                <layout:FilterCard Grid.Row="1"
                                   Margin="0,0,0,20">

                    <layout:FilterCard.FilterContent>

                        <StackPanel>

                            <filters:SearchBox Label="Buscar ticket"
                                               SearchText="{Binding SearchText, Mode=TwoWay}"
                                               SearchCommand="{Binding SearchCommand}"
                                               IsLoading="{Binding IsLoading}"/>

                            <feedback:QueryStatus Margin="0,12,0,0"
                                                  IsLoading="{Binding IsLoading}"
                                                  LoadingMessage="Cargando tickets..."
                                                  ErrorMessage="{Binding QueryErrorMessage}"/>

                        </StackPanel>

                    </layout:FilterCard.FilterContent>

                </layout:FilterCard>

                <!-- Bloque 3: Tabla y paginacion -->
                <layout:DataCard Grid.Row="2">

                    <layout:DataCard.DataContent>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <amounts:AmountsTableView Grid.Row="0"/>

                            <!-- Mensaje de tabla vacia, debajo de los encabezados -->
                            <feedback:EmptyState Grid.Row="0"
                                                 Margin="0,42,0,0"
                                                 Message="{Binding EmptyMessage}"
                                                 Visibility="{Binding IsEmpty,
                                                                      Converter={StaticResource BoolToVisibility}}"/>

                            <pagination:PaginationControl Grid.Row="1"
                                                          Margin="0,16,0,0"
                                                          TotalCount="{Binding TotalCount}"
                                                          CurrentPage="{Binding CurrentPage}"
                                                          TotalPages="{Binding TotalPages}"
                                                          PageSize="{Binding PageSize, Mode=TwoWay}"
                                                          PageSizeOptions="{Binding PageSizeOptions}"
                                                          ChangePageSizeCommand="{Binding ChangePageSizeCommand}"
                                                          PreviousPageCommand="{Binding PreviousPageCommand}"
                                                          NextPageCommand="{Binding NextPageCommand}"/>

                        </Grid>

                    </layout:DataCard.DataContent>

                </layout:DataCard>

            </Grid>

        </layout:PageLayout.PageContent>

    </layout:PageLayout>

</UserControl>