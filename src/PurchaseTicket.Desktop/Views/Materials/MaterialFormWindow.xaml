<Window x:Class="PurchaseTicket.Desktop.Views.Materials.MaterialFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback"
        xmlns:forms="clr-namespace:PurchaseTicket.Desktop.Components.Forms"
        Title="{Binding WindowTitle}"
        Width="560"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBrush}"
        Closing="Window_Closing">

    <!-- Misma estructura que las demas ventanas de formulario -->
    <forms:DialogLayout Title="{Binding WindowTitle}"
                        Description="{Binding Description}">

        <!-- Al editar: si el material esta activo o inactivo -->
        <forms:DialogLayout.HeaderContent>

            <feedback:StatusBadge Text="{Binding StatusText}"
                                  Kind="{Binding StatusKind}"
                                  Visibility="{Binding IsEditMode,
                                                       Converter={StaticResource BoolToVisibility}}"/>

        </forms:DialogLayout.HeaderContent>

        <forms:DialogLayout.BodyContent>

            <StackPanel>

                <!-- Campos bloqueados mientras se guarda -->
                <StackPanel>

                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaving}"
                                             Value="True">
                                    <Setter Property="IsEnabled"
                                            Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <StackPanel>
                        <forms:FormTextField Label="Nombre del material"
                                             IsRequired="True"
                                             FocusOnLoad="True"
                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="50"
                                             CounterLimit="50"/>

                        <!-- "Sin cambio" o "Antes ..."; vacio al registrar -->
                        <TextBlock Text="{Binding NameHint}"
                                   Style="{StaticResource ChangeHintStyle}"
                                   Visibility="{Binding IsEditMode,
                                                        Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                </StackPanel>

                <!-- Indicador de guardado -->
                <TextBlock Text="Guardando material..."
                           FontSize="13"
                           FontStyle="Italic"
                           Margin="0,14,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="{Binding IsSaving,
                                                Converter={StaticResource BoolToVisibility}}"/>

                <!-- Errores generales, como no haber cambiado nada -->
                <feedback:QueryStatus Margin="0,14,0,0"
                                      ErrorMessage="{Binding ErrorMessage}"
                                      IsLoading="False"/>

            </StackPanel>

        </forms:DialogLayout.BodyContent>

        <!-- Los tickets leen el nombre actual: un cambio se ve tambien en los ya registrados -->
        <forms:DialogLayout.FooterContent>

            <TextBlock Text="Los tickets muestran el nombre nuevo"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="{Binding IsEditMode,
                                            Converter={StaticResource BoolToVisibility}}"/>

        </forms:DialogLayout.FooterContent>

        <forms:DialogLayout.Actions>

            <forms:FormActions SaveButtonText="{Binding SaveButtonText}"
                               SaveCommand="{Binding SaveCommand}"
                               CancelCommand="{Binding CancelCommand,
                                                       RelativeSource={RelativeSource AncestorType=Window}}"
                               IsSaving="{Binding IsSaving}"/>

        </forms:DialogLayout.Actions>

    </forms:DialogLayout>

</Window>
