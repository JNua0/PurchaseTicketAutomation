<UserControl x:Class="PurchaseTicket.Desktop.Views.Materials.MaterialTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actions="clr-namespace:PurchaseTicket.Desktop.Components.Actions"
             xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback">

    <!-- Tabla de materiales -->
    <DataGrid Style="{StaticResource AppDataGridStyle}"
              ItemsSource="{Binding Items}"
              SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

        <DataGrid.Columns>

            <!-- Identificador del material -->
            <DataGridTextColumn Header="ID"
                                Binding="{Binding Id}"
                                Width="75"
                                MinWidth="75"/>

            <!-- Nombre del material -->
            <DataGridTextColumn Header="Material"
                                Binding="{Binding Name}"
                                Width="*"
                                MinWidth="220"/>

            <!-- Estado del material -->
            <DataGridTemplateColumn Header="Estado"
                                    Width="120"
                                    MinWidth="120">

                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <feedback:StatusBadge
                            Style="{StaticResource ActiveStatusBadgeStyle}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>

            </DataGridTemplateColumn>

            <!-- Acciones individuales del material -->
            <DataGridTemplateColumn Header="Acciones"
                                    Width="120"
                                    MinWidth="120"
                                    MaxWidth="120"
                                    CanUserResize="False">

                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Editar material -->
                            <actions:EditActionButton
                                Command="{Binding DataContext.EditMaterialCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"
                                ToolTip="Editar material"
                                Margin="0,0,8,0"/>

                            <!-- Activar o desactivar material -->
                            <actions:StatusActionButton
                                IsActive="{Binding IsActive}"
                                Command="{Binding DataContext.ChangeMaterialStatusCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>

            </DataGridTemplateColumn>

        </DataGrid.Columns>

    </DataGrid>

</UserControl>
