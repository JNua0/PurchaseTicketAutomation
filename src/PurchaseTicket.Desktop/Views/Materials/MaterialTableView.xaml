<UserControl x:Class="PurchaseTicket.Desktop.Views.Materials.MaterialTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actions="clr-namespace:PurchaseTicket.Desktop.Components.Actions"
             xmlns:feedback="clr-namespace:PurchaseTicket.Desktop.Components.Feedback">

    <!-- Tabla de materiales -->
    <DataGrid Style="{StaticResource AppDataGridStyle}"
              ItemsSource="{Binding Items}"
              SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

        <!-- Doble clic o Enter en una fila abre la edicion, como el detalle en Tickets -->
        <DataGrid.InputBindings>
            <MouseBinding Gesture="LeftDoubleClick"
                          Command="{Binding EditMaterialCommand}"
                          CommandParameter="{Binding SelectedItem,
                                                     RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
            <KeyBinding Key="Enter"
                        Command="{Binding EditMaterialCommand}"
                        CommandParameter="{Binding SelectedItem,
                                                   RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        </DataGrid.InputBindings>

        <!-- Los inactivos en gris para distinguirlos de un vistazo -->
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow"
                   BasedOn="{StaticResource AppDataGridRowStyle}">
                <Setter Property="ToolTip"
                        Value="Doble clic para editar"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}"
                                 Value="False">
                        <Setter Property="Foreground"
                                Value="{StaticResource SecondaryTextBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DataGrid.RowStyle>

        <DataGrid.Columns>

            <!-- Identificador del material -->
            <DataGridTextColumn Header="ID"
                                Binding="{Binding Id}"
                                Width="75"
                                MinWidth="75"/>

            <!-- Nombre del material -->
            <DataGridTextColumn Header="Material"
                                Binding="{Binding Name}"
                                Width="*"
                                MinWidth="220"/>

            <!-- Estado del material -->
            <DataGridTemplateColumn Header="Estado"
                                    Width="120"
                                    MinWidth="120">

                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <feedback:StatusBadge
                            Style="{StaticResource ActiveStatusBadgeStyle}"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>

            </DataGridTemplateColumn>

            <!-- Acciones individuales del material -->
            <DataGridTemplateColumn Header="Acciones"
                                    HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                    Width="120"
                                    MinWidth="120"
                                    MaxWidth="120"
                                    CanUserResize="False">

                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Editar material -->
                            <actions:RowActionButton Icon="{StaticResource EditIcon}"
                                                     Variant="Edit"
                                                     ToolTip="Editar material"
                                                     Command="{Binding DataContext.EditMaterialCommand,
                                                                       RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                     CommandParameter="{Binding}"
                                                     Margin="0,0,8,0"/>

                            <!-- Activar o desactivar material -->
                            <actions:RowActionButton Command="{Binding DataContext.ChangeMaterialStatusCommand,
                                                                       RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                     CommandParameter="{Binding}">

                                <!-- Activo: desactivar en rojo. Inactivo: activar en verde -->
                                <actions:RowActionButton.Style>
                                    <Style TargetType="actions:RowActionButton">

                                        <Setter Property="Icon"
                                                Value="{StaticResource DeactivateIcon}"/>
                                        <Setter Property="Variant"
                                                Value="Danger"/>
                                        <Setter Property="ToolTip"
                                                Value="Desactivar material"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}"
                                                         Value="False">
                                                <Setter Property="Icon"
                                                        Value="{StaticResource ActivateIcon}"/>
                                                <Setter Property="Variant"
                                                        Value="Success"/>
                                                <Setter Property="ToolTip"
                                                        Value="Activar material"/>
                                            </DataTrigger>
                                        </Style.Triggers>

                                    </Style>
                                </actions:RowActionButton.Style>

                            </actions:RowActionButton>

                        </StackPanel>

                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>

            </DataGridTemplateColumn>

        </DataGrid.Columns>

    </DataGrid>

</UserControl>
