<UserControl x:Class="PurchaseTicket.Desktop.Views.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F8FAFC">
        <StackPanel Margin="30"
                    VerticalAlignment="Top">

            <TextBlock Text="Inicio"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="Bienvenido a PurchaseTicket Automation"
                       FontSize="16"
                       Foreground="#64748B"
                       Margin="0,10,0,30"/>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <StackPanel>
                    <TextBlock Text="Panel principal"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Selecciona una opción del menú lateral para comenzar."
                        Foreground="#64748B"
                        TextWrapping="Wrap"
                        Margin="0,10,0,0"/>
                </StackPanel>

            </Border>

        </StackPanel>
    </Grid>
</UserControl>
