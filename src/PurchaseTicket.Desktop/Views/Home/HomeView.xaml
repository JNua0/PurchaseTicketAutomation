<UserControl x:Class="PurchaseTicket.Desktop.Views.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:PurchaseTicket.Desktop.Components.Layout">

    <layout:PageLayout>

        <layout:PageLayout.PageContent>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bloque 1: Encabezado -->
                <layout:PageHeader Grid.Row="0"
                                   Title="Inicio"
                                   Description="Bienvenido a PurchaseTicket Automation"/>

                <!-- Bloque 2: Contenido principal -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        VerticalAlignment="Top">

                    <StackPanel>

                        <TextBlock Text="Panel principal"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                        <TextBlock Text="Selecciona una opción del menú lateral para comenzar."
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </layout:PageLayout.PageContent>

    </layout:PageLayout>

</UserControl>
